---
// Legal page (/legal/…, /en/legal/…): plain reading layout with a contents list.
import '../../styles/next.css';
import '../../styles/blog.css';
import { PortableText } from 'astro-portabletext';
import Base from '../../layouts/Base.astro';
import SiteNav from '../site/SiteNav.astro';
import SiteFooter from '../site/SiteFooter.astro';
import PostHeading from '../blog/PostHeading.astro';
import { formatDate } from '../../i18n';
import { legalPath, type LegalPage } from '../../lib/sanity';
import { headingsOf } from '../../lib/text';
interface Props { page: LegalPage }
const { page } = Astro.props;
const language = page.language;
const pl = language === 'pl';
const translation = page.translations[0];
const toc = headingsOf(page.body);
---
<Base locale={language} title={`${page.title} – Nuuvie`} description={`${page.title} – Nuuvie Studio`}>
  <SiteNav language={language} alternate={translation ? legalPath(translation.language, translation.slug) : undefined} />
  <main id="top" class="x b">
    <article data-b-article>
      <header class="x-wrap b-head">
        <h1 data-split="lines">{page.title}</h1>
        <p class="b-meta" data-fade><span>{pl ? 'Ostatnia aktualizacja' : 'Last updated'}: {formatDate(page.updatedAt, language)}</span></p>
      </header>
      <div class="x-wrap b-layout">
        <aside class="b-aside">
          <div class="b-aside__in">
            {toc.length > 1 && (
              <nav class="b-toc" aria-label={pl ? 'Spis treści' : 'Contents'}>
                <p>{pl ? 'Spis treści' : 'Contents'}</p>
                <ol>{toc.map((h) => <li><a href={`#${h.id}`} data-b-toc={h.id}>{h.text}</a></li>)}</ol>
              </nav>
            )}
          </div>
        </aside>
        <div class="b-body b-body--legal">
          <PortableText value={page.body as never} components={{ block: { h2: PostHeading, h3: PostHeading } }} />
        </div>
      </div>
    </article>
  </main>
  <SiteFooter language={language} />
  <script>
    import '../../scripts/blog';
  </script>
</Base>
