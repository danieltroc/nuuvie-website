---
import type { Dict } from '../../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="section work container" id="work">
  <header class="section-head">
    <span class="mono label" data-fade>{t.work.label} ({String(t.work.items.length).padStart(2, '0')})</span>
    <h2 class="h2" data-split="lines">{t.work.title}</h2>
  </header>
  <div class="work__list">
    {t.work.items.map((w, i) => (
      <a class="work-card" href={w.href} style={`--i:${i}`} data-work-card data-cursor={t.work.cursor}>
        <article class="work-card__inner" data-work-inner>
          <div class="work-card__media" data-work-media><img src={w.img} alt="" width="2400" height="1350" loading={i === 0 ? 'eager' : 'lazy'} /></div>
          <div class="work-card__top mono"><span>0{i + 1} / 0{t.work.items.length}</span><span>{w.kicker}</span></div>
          <div class="work-card__bottom">
            <div>
              <h3 class="work-card__name">{w.name}</h3>
              <p class="work-card__desc">{w.desc}</p>
            </div>
            <ul class="tags mono">{w.tags.map((tag) => <li>{tag}</li>)}</ul>
          </div>
          <div class="work-card__shade" data-work-shade></div>
        </article>
      </a>
    ))}
  </div>
</section>
