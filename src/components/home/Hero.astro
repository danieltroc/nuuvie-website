---
import Button from '../Button.astro';
import type { Dict } from '../../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="hero container" data-hero>
  <div class="hero__meta mono" data-hero-meta>
    <ul>{t.hero.meta.map((m) => <li>{m}</li>)}</ul>
    <span>©{new Date().getFullYear()}</span>
  </div>

  <p class="hero__wordmark" aria-label="Nuuvie Studio" data-hero-wordmark>
    <span aria-hidden="true">Nuuvie</span><span aria-hidden="true">Studio</span>
  </p>

  <ul class="hero__services">
    {t.hero.services.map((s, i) => (
      <li>
        <div class="rule" data-hero-rule></div>
        <span class="mono" data-hero-svc>0{i + 1}</span>
        <span data-hero-svc>{s}</span>
      </li>
    ))}
  </ul>

  <div class="hero__body">
    <figure class="hero__portrait" data-hero-portrait>
      <img src="/img/daniel.jpg" alt={t.hero.portraitAlt} width="1024" height="1023" fetchpriority="high" data-parallax="8" />
      <figcaption class="mono">{t.manifesto.author}</figcaption>
    </figure>
    <div>
      <h1 class="hero__title" data-hero-title>{t.hero.title}</h1>
      <div class="hero__subs">{t.hero.subs.map((s) => <p data-hero-fade>{s}</p>)}</div>
      <div class="hero__cta" data-hero-fade><Button href="#contact" label={t.hero.cta} /></div>
    </div>
  </div>
</section>
