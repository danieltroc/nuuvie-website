---
import Button from '../Button.astro';
import type { Dict } from '../../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="section container" id="services">
  <div class="services__grid">
    <div class="services__aside">
      <span class="mono label" data-fade>{t.services.label}</span>
      <h2 class="h2" data-split="lines">{t.services.title}</h2>
      <div data-fade><Button href="#contact" label={t.services.cta} /></div>
    </div>
    <ul data-fade-group>
      {t.services.items.map((s, i) => (
        <li class="svc" data-fade>
          <button class="svc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`svc-${i}`} data-accordion>
            <span class="svc__num mono">0{i + 1}</span>
            <span class="svc__title">{s.title}</span>
            <span class="svc__plus" aria-hidden="true"></span>
          </button>
          <div class="svc__panel" id={`svc-${i}`}><div><p>{s.body}</p></div></div>
        </li>
      ))}
    </ul>
  </div>
</section>
