---
import type { Dict } from '../../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="section testimonials on-ink">
  <div class="container">
    <header class="section-head">
      <span class="mono label" data-fade>{t.testimonials.label}</span>
      <h2 class="testimonials__title" data-split="lines">{t.testimonials.title.map((l) => <span>{l}</span>)}</h2>
    </header>
    <div class="testimonials__grid" data-fade-group>
      {t.testimonials.items.map((q) => (
        <figure class:list={['quote', q.quote.length > 140 && 'quote--long']} data-fade>
          <blockquote>“{q.quote}”</blockquote>
          <figcaption>
            <img src={q.img} alt="" width="96" height="96" loading="lazy" />
            <div><strong>{q.name}</strong><span class="mono muted">{q.company}</span></div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
