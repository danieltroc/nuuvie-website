---
import { type Dict, socials } from '../../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="section contact container" id="contact">
  <span class="mono label" data-fade>{t.contact.label}</span>
  <h2 class="contact__title">{t.contact.title.map((l) => <span><i data-rise>{l}</i></span>)}</h2>
  <div class="contact__grid" data-fade-group>
    <div class="contact__col" data-fade>
      <span class="mono muted">{t.contact.writeLabel}</span>
      <a class="contact__email link" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
      <ul class="mono">{socials.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
    </div>
    <div class="contact__col" data-fade>
      <span class="mono muted">{t.contact.bookLabel}</span>
      <p>{t.contact.bookText}</p>
      <a class="orb" href={t.contact.bookHref} data-magnetic><span>{t.contact.bookCta}</span></a>
    </div>
  </div>
</section>
