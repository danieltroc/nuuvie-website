---
import Button from '../Button.astro';
import Arrow from '../Arrow.astro';
import { type Dict, type Locale, formatDate } from '../../i18n';
interface Props { t: Dict; locale: Locale }
const { t, locale } = Astro.props;
---
<section class="section container" id="blog">
  <header class="section-head">
    <span class="mono label" data-fade>{t.blog.label}</span>
    <div class="blog__top">
      <h2 class="h2" data-split="lines">{t.blog.title}</h2>
      <div data-fade><Button href={t.blog.href} label={t.blog.cta} /></div>
    </div>
  </header>
  <ul class="blog__list" data-fade-group data-blog-list>
    {t.blog.posts.map((p, i) => (
      <li class="post" data-fade>
        <a href={p.href} data-post={i}>
          <div class="post__thumb"><img src={p.img} alt="" width="144" height="144" loading="lazy" /></div>
          <time class="mono" datetime={p.date}>{formatDate(p.date, locale)}</time>
          <h3>{p.title}</h3>
          <span class="post__arrow" aria-hidden="true"><Arrow /></span>
        </a>
      </li>
    ))}
  </ul>
  <div class="blog__preview" data-blog-preview aria-hidden="true">
    {t.blog.posts.map((p) => <img src={p.img} alt="" loading="lazy" />)}
  </div>
</section>
