---
import type { Dict } from '../../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="section container" id="about">
  <div class="manifesto__grid">
    <span class="mono label" data-fade>{t.manifesto.label}</span>
    <div>
      <div class="manifesto__text" data-scrub-words>
        <p>{t.manifesto.lead}</p>
        <p>{t.manifesto.body}</p>
      </div>
      <div class="manifesto__author" data-fade>
        <img src="/img/daniel.jpg" alt="" width="112" height="112" loading="lazy" />
        <div><strong>{t.manifesto.author}</strong><span class="mono muted">{t.manifesto.role}</span></div>
      </div>
    </div>
  </div>
</section>
