---
// "Nova" — a free-form variant: Apple calm × Swiss grid. No portrait, own layout, lightly rewritten copy.
// Polish only; shares the dictionary for services, work, stats, quotes and posts.
import '../../styles/nova.css';
import '../../styles/nova-swiss.css';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Button from '../../components/Button.astro';
import Mark from '../../components/Mark.astro';
import Arrow from '../../components/Arrow.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import { getDict, formatDate, socials, clientLogos } from '../../i18n';

interface Props { variant: 'nova' | 'nova-swiss' }
const { variant } = Astro.props;
const swiss = variant === 'nova-swiss';
const t = getDict('pl');
const roll = ['marki,', 'aplikacje,', 'strony,', 'produkty,'];

// Two-path CTA (Nova Swiss). Designer copy is condensed from nuuvie.com/strefa-designera.
const LIVE = 'https://www.nuuvie.com';
const paths = [
  {
    letter: 'A',
    tag: 'Dla biznesu',
    title: 'Masz markę lub produkt do zaprojektowania?',
    lead: 'Od logo po aplikację. Przekładam Twoją wizję na język korzyści i intuicyjny design.',
    items: ['Logo i identyfikacja wizualna', 'Strony, aplikacje i UX / UI', 'Strategia, rozwój i audyty', 'Wsparcie Twojego zespołu'],
    meta: 'Pierwsza rozmowa · 15 min · bezpłatnie',
    cta: 'Porozmawiajmy o projekcie',
    href: t.contact.bookHref,
    alt: `Albo napisz: ${t.contact.email}`,
    altHref: `mailto:${t.contact.email}`,
    dark: false,
  },
  {
    letter: 'B',
    tag: 'Dla designerów',
    title: 'Rozwijasz się w designie?',
    lead: 'Konsultacje i mentoring z designerem z 15-letnim stażem. Pracujemy na Twoim konkretnym przypadku.',
    items: ['Przegląd portfolio', 'Plan rozwoju i kolejne kroki', 'Feedback do Twoich projektów', 'Rynek pracy, freelancing, narzędzia'],
    meta: 'Konsultacja 1:1 · 90 min · 249 zł',
    cta: 'Strefa Designera',
    href: `${LIVE}/strefa-designera`,
    alt: 'Nie wiesz, czy to dla Ciebie? Darmowe 15-min intro',
    altHref: `${LIVE}/strefa-designera`,
    dark: true,
  },
];
const year = new Date().getFullYear();
---
<Base locale="pl" theme={variant}>
  <DesignSwitcher theme={variant} />
  <Nav locale="pl" />

  <main id="top" class:list={['nova', swiss && 'nova--swiss']}>
    <!-- ───── Hero: type only. The mark grows into the next section on scroll ───── -->
    <section class="n-hero" data-n-hero>
      <div class="n-hero__content" data-n-content>
        <div class="n-hero__meta mono" data-n-in>
          <span>Nuuvie Studio</span>
          <span class="n-hide-s">UX / UI · Branding · Strony</span>
          <span>PL <span data-n-clock>--:--</span></span>
        </div>

        <h1 class="n-hero__title" aria-label="Projektuję marki, aplikacje, strony i produkty, którym się ufa.">
          <span class="n-line" aria-hidden="true"><i data-n-rise>Projektuję</i></span>
          <span class="n-line n-roll" aria-hidden="true" data-n-roll data-n-roll-every={swiss ? 3.4 : 2.4}>
            {roll.map((w) => <i>{w}</i>)}
          </span>
          <span class="n-line" aria-hidden="true"><i data-n-rise>którym się ufa.</i></span>
        </h1>

        <div class="n-hero__foot">
          <div class="n-hero__lead" data-n-in>
            <p>15 lat doświadczenia w UX/UI i brandingu. Twoja wizja przełożona na język korzyści i intuicyjny design.</p>
            <Button href="#contact" label="Porozmawiajmy o projekcie" />
          </div>
          <span class="mono n-hero__scroll n-hide-s" data-n-in>Przewiń ↓</span>
        </div>
      </div>
      {swiss && (
        <ul class="n-index" data-n-in>
          {t.hero.services.map((s, i) => <li><span class="mono">0{i + 1}</span>{s}</li>)}
        </ul>
      )}
      {!swiss && (
      <div class="n-hero__mark" data-n-mark aria-hidden="true">
        <svg viewBox="0 0 121 121"><path d="M60.419 90.627C60.419 107.311 46.894 120.836 30.21 120.836C13.526 120.836 0.0002 107.311 0 90.627V30.21C0 13.526 13.526 0 30.21 0H60.419V90.627ZM90.633 0C107.317 0 120.842 13.526 120.842 30.21C120.842 46.868 107.359 60.376 90.711 60.418H120.842V90.627C120.842 107.311 107.317 120.836 90.633 120.836C73.949 120.836 60.424 107.311 60.424 90.627V60.418H90.555C73.907 60.376 60.424 46.868 60.424 30.21C60.424 13.526 73.949 0 90.633 0Z" fill="currentColor"/></svg>
      </div>
      )}
    </section>

    <!-- ───── Work: dark bento ───── -->
    <section class="n-work" id="work">
      <header class="n-head">
        <h2 class="n-h2" data-split="lines">Wybrane projekty</h2>
        <span class="mono" data-fade>(0{t.work.items.length}) projekty</span>
      </header>
      <div class="n-bento">
        {t.work.items.map((w, i) => (
          <a class="n-card" href={w.href} data-fade data-cursor={t.work.cursor}>
            <img src={w.img} alt="" width="2400" height="1350" loading={i === 0 ? 'eager' : 'lazy'} />
            <span class="n-card__idx mono">0{i + 1}</span>
            <div class="n-card__info">
              <div>
                <h3>{w.name}</h3>
                <p>{w.desc}</p>
              </div>
              <ul class="mono">{w.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ───── Manifesto ───── -->
    <section class="n-manifesto" id="about">
      <span class="mono n-label" data-fade>Dlaczego to robię</span>
      <div class="n-manifesto__text" data-scrub-words>
        <p>Design to narzędzie, które eliminuje domysły Twoich klientów. Marka ma mówić to, co najważniejsze, zanim ktokolwiek przeczyta pierwsze słowo.</p>
      </div>
      <p class="mono n-manifesto__sig" data-fade>{t.manifesto.author} — {t.manifesto.role}</p>
    </section>

    <!-- ───── Services: sticky rolling index ───── -->
    <section class="n-svc" id="services">
      <div class="n-svc__grid">
        <div class="n-svc__aside">
          <span class="mono n-label">Usługi</span>
          <div class="n-num" aria-hidden="true">
            <span>0</span>
            <span class="n-num__col" data-n-digits>{t.services.items.map((_, i) => <i>{i + 1}</i>)}</span>
          </div>
          <p class="n-svc__q">Co zrobię dla Twojego biznesu?</p>
        </div>
        <ol class="n-svc__list">
          {t.services.items.map((s, i) => (
            <li class="n-svc__item" data-n-svc={i}>
              <span class="mono n-svc__n">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ───── Numbers + clients table ───── -->
    <section class="n-facts">
      <div class="n-stats">
        {t.stats.map((s) => (
          <div class="n-stat">
            <p class="n-stat__v"><span data-count={s.value}>{s.value}</span>{s.suffix && <sup>{s.suffix}</sup>}</p>
            <p><span class="mono">{s.unit}</span>{s.text}</p>
          </div>
        ))}
      </div>
      <p class="mono n-label n-facts__label" data-fade>Projektowałem dla</p>
      <ul class="n-clients">
        {clientLogos.map((l) => <li data-fade><img src={`/img/logos/${l}.svg`} alt={l} width="150" height="100" loading="lazy" /></li>)}
      </ul>
    </section>

    <!-- ───── Testimonials: one voice at a time ───── -->
    <section class="n-quotes" data-n-quotes aria-label={t.testimonials.label}>
      <div class="n-quotes__side">
        <span class="mono n-label">Wybierają nas CEO i founderzy</span>
        <div class="n-quotes__tabs" role="tablist">
          {t.testimonials.items.map((q, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-n-tab={i}>
              <span class="mono">0{i + 1}</span>
              <span><strong>{q.name}</strong><em class="mono">{q.company}</em></span>
              <i data-n-bar></i>
            </button>
          ))}
        </div>
      </div>
      <div class="n-quotes__stage">
        {t.testimonials.items.map((q, i) => (
          <blockquote class:list={[i === 0 && 'is-active', q.quote.length > 140 && 'is-long']} data-n-quote={i}>„{q.quote}”</blockquote>
        ))}
      </div>
    </section>

    <!-- ───── Blog ───── -->
    <section class="n-blog" id="blog">
      <header class="n-head">
        <h2 class="n-h2" data-split="lines">Piszemy o designie</h2>
        <a class="link mono" href={t.blog.href} data-fade>Wszystkie wpisy →</a>
      </header>
      {/* Nova Swiss uses the Apple / Swiss row list; its pointer preview comes from motion.ts */}
      {swiss ? (
        <>
          <ul class="blog__list" data-fade-group data-blog-list>
            {t.blog.posts.map((p, i) => (
              <li class="post" data-fade>
                <a href={p.href} data-post={i}>
                  <div class="post__thumb"><img src={p.img} alt="" width="144" height="144" loading="lazy" /></div>
                  <time class="mono" datetime={p.date}>{formatDate(p.date, 'pl')}</time>
                  <h3>{p.title}</h3>
                  <span class="post__arrow" aria-hidden="true"><Arrow /></span>
                </a>
              </li>
            ))}
          </ul>
          <div class="blog__preview" data-blog-preview aria-hidden="true">
            {t.blog.posts.map((p) => <img src={p.img} alt="" loading="lazy" />)}
          </div>
        </>
      ) : (
      <div class="n-blog__grid">
        {t.blog.posts.slice(0, 3).map((p) => (
          <a class="n-post" href={p.href} data-fade>
            <div class="n-post__img"><img src={p.img} alt="" width="1344" height="896" loading="lazy" /></div>
            <time class="mono" datetime={p.date}>{formatDate(p.date, 'pl')}</time>
            <h3>{p.title}</h3>
          </a>
        ))}
      </div>
      )}
    </section>

    <!-- ───── Two paths: business clients and designers (Nova Swiss only) ───── -->
    {swiss && (
      <section class="n-paths" id="paths">
        <header class="n-head">
          <div>
            <span class="mono n-label" data-fade>Współpraca</span>
            <h2 class="n-h2" data-split="lines">Dwie ścieżki.</h2>
          </div>
          <p class="n-paths__intro" data-fade>Projektuję dla firm i pomagam rosnąć designerom. Wybierz, która ścieżka jest Twoja.</p>
        </header>
        <div class="n-paths__grid">
          {paths.map((p) => (
            <article class:list={['n-path', p.dark && 'n-path--dark']} data-fade>
              <p class="n-path__tag mono"><span>{p.letter}</span>{p.tag}</p>
              <h3>{p.title}</h3>
              <p class="n-path__lead">{p.lead}</p>
              <ul class="n-path__list">{p.items.map((it) => <li>{it}</li>)}</ul>
              <div class="n-path__foot">
                <p class="mono">{p.meta}</p>
                <Button href={p.href} label={p.cta} variant={p.dark ? 'light' : 'dark'} />
                <a class="link n-path__alt" href={p.altHref}>{p.alt}</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ───── Contact + footer ───── -->
    <section class="n-contact" id="contact">
      <span class="mono n-label" data-fade>Kontakt</span>
      <h2 class="n-contact__title" data-split="lines">Czas na Twój ruch.</h2>
      <button class="n-mail" type="button" data-n-copy={t.contact.email} data-fade>
        <span>{t.contact.email}</span>
        <em class="mono" data-n-copy-hint>Kliknij, aby skopiować</em>
      </button>
      {!swiss && (
        <div class="n-contact__row" data-fade>
          <p>Wolisz porozmawiać? Wybierz termin bezpłatnej, 15-minutowej konsultacji.</p>
          <Button href={t.contact.bookHref} label={t.contact.bookCta} />
        </div>
      )}
      <footer class="n-foot mono">
        <a class="brand" href={`/design/${variant}/`} aria-label="Nuuvie Studio"><Mark id="mark-nova" />Nuuvie</a>
        <ul>{socials.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
        <ul>{t.footer.legal.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}</ul>
        <span>© {year} Nuuvie</span>
      </footer>
    </section>
  </main>

  <div class="cursor mono" data-cursor-el aria-hidden="true"><span></span></div>
  <script>
    import '../../scripts/nova';
  </script>
</Base>
