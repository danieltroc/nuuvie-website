---
// Compact top bar used by the Tiles / Form / Reel variants.
import Mark from '../Mark.astro';
interface Props { id: string }
const { id } = Astro.props;
const links = [
  { href: '#work', label: 'Prace' },
  { href: '#services', label: 'Usługi' },
  { href: '#about', label: 'Studio' },
  { href: '#blog', label: 'Blog' },
];
---
<header class="m-nav">
  <a class="brand" href={`/design/${id}/`} aria-label="Nuuvie Studio"><Mark id={`mark-nav-${id}`} /><span>Nuuvie</span></a>
  <nav aria-label="Menu">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  <a class="m-nav__cta" href="#contact">Porozmawiajmy</a>
</header>
