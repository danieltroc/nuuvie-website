---
// Review tool: flip between design variants. Remove this component once a direction is chosen.
import { themes } from '../i18n';
interface Props { theme?: string }
const { theme } = Astro.props;
---
<nav class="switcher" aria-label="Design variants">
  <a href="/" aria-current={!theme ? 'page' : undefined}>Original</a>
  {themes.map((t) => <a href={`/design/${t.id}/`} aria-current={theme === t.id ? 'page' : undefined}>{t.label}</a>)}
</nav>
