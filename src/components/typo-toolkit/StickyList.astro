---
// Two-column block: a big heading with a short lead and a button that stays in view on wide
// screens (sticky), and a list of items with icons on the right. Styles: .tt-benC* in
// styles/typo-toolkit.css. Not used yet; saved from the "Co z tego masz" variants for another section.
//
// <StickyList title="…" lead="…" items={[{ t: '…', d: '…', icon: 'clock' }]}>
//   <a class="x-btn" href="…">…</a>   ← optional, goes under the lead
// </StickyList>
interface Item { t: string; d: string; icon?: keyof typeof icons }
interface Props { title: string; lead?: string; items: Item[] }
const { title, lead, items } = Astro.props;

const icons = {
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>',
  shuffle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3.5c4 0 5 10 9 10H20M4 17h3.5c1.6 0 2.7-1.6 3.6-3.5M14 9.5c.7-1.4 1.5-2.5 2.5-2.5H20M17.5 4.5 20 7l-2.5 2.5M17.5 14.5 20 17l-2.5 2.5"/></svg>',
  eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.75"/></svg>',
  chat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12.5a7.5 7.5 0 0 1-10.9 6.7L4 20l1-4.4A7.5 7.5 0 1 1 20 12.5Z"/><path d="M9 11h6M9 14h4"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>',
};
---
<div class="tt-benC" style="display: grid">
  <div class="tt-benC__side">
    <h2>{title}</h2>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
  <ul class="tt-benC__list">
    {items.map((it) => (
      <li data-fade>
        <span class="tt-benC__icon" set:html={icons[it.icon ?? 'check']} />
        <div><h3>{it.t}</h3><p>{it.d}</p></div>
      </li>
    ))}
  </ul>
</div>
