---
import Mark from './Mark.astro';
import { type Locale, getDict, homePath, socials } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const links = [
  { href: '#work', label: t.nav.work },
  { href: '#services', label: t.nav.services },
  { href: '#about', label: t.nav.about },
  { href: '#blog', label: t.nav.blog },
  { href: t.footer.designerZone.href, label: t.footer.designerZone.label },
];
---
<footer class="footer on-ink">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__intro">
        <a class="brand" href={homePath(locale)} aria-label="Nuuvie Studio"><Mark id="mark-foot" />Nuuvie</a>
        <p>{t.footer.tagline}</p>
      </div>
      <div class="footer__col">
        <span class="mono muted">{t.footer.navLabel}</span>
        <ul>{links.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div class="footer__col">
        <span class="mono muted">{t.footer.socialLabel}</span>
        <ul>{socials.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      </div>
      <div class="footer__col">
        <span class="mono muted">{t.footer.legalLabel}</span>
        <ul>{t.footer.legal.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="footer__bottom mono">
      <span>© {new Date().getFullYear()} Nuuvie. {t.footer.rights}</span>
      <a class="link" href="#top">{t.footer.top} ↑</a>
    </div>
  </div>
  <div class="footer__word" aria-hidden="true" data-footer-word>Nuuvie</div>
</footer>
