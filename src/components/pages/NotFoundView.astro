---
// "Page not found" (PL dist/404.html, EN dist/en/404.html). Cloudflare serves the nearest 404.html
// for an unknown address (wrangler.jsonc: not_found_handling "404-page"), so /en/... gets the English one.
// A line draws in and breaks off into dots: the path that leads nowhere.
import '../../styles/next.css';
import Base from '../../layouts/Base.astro';
import SiteNav from '../site/SiteNav.astro';
import SiteFooter from '../site/SiteFooter.astro';
import type { Locale } from '../../i18n';

interface Props { language: Locale }
const { language } = Astro.props;
const pl = language === 'pl';
const copy = pl
  ? {
      title: 'Nie ma takiej strony – Nuuvie',
      heading: 'Ta ścieżka nigdzie nie prowadzi.',
      lead: 'Strona, której szukasz, nie istnieje albo zmieniła adres.',
      home: 'Strona główna',
      contact: 'Napisz do mnie',
    }
  : {
      title: 'Page not found – Nuuvie',
      heading: 'This path leads nowhere.',
      lead: 'The page you are looking for does not exist or has moved.',
      home: 'Home',
      contact: 'Get in touch',
    };
const homeHref = pl ? '/' : '/en';
const contactHref = pl ? '/kontakt' : '/en/kontakt';
const arrow = '<svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg>';
---
<Base locale={language} title={copy.title} noindex>
  <SiteNav language={language} />
  <main id="top" class="x">
    <section class="x-wrap nf">
      <svg class="nf__line" viewBox="0 0 800 120" fill="none" aria-hidden="true">
        <path class="nf__path" d="M0 90 C 120 90, 160 30, 260 30 S 400 90, 500 70" stroke="#0a0a0a" stroke-width="2" />
        <path class="nf__dash" d="M500 70 C 560 58, 600 50, 640 50" stroke="#0a0a0a" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
        <circle class="nf__end" cx="660" cy="50" r="7" stroke="#864af9" stroke-width="2" />
      </svg>
      <h1>{copy.heading}</h1>
      <p>{copy.lead}</p>
      <div class="x-actions">
        <a class="x-btn" href={homeHref}><span class="x-btn__label"><span>{copy.home}</span><span aria-hidden="true">{copy.home}</span></span><span class="x-btn__icon" aria-hidden="true"><Fragment set:html={arrow} /><Fragment set:html={arrow} /></span></a>
        <a class="x-btn x-btn--ghost" href={contactHref}><span class="x-btn__label"><span>{copy.contact}</span><span aria-hidden="true">{copy.contact}</span></span></a>
      </div>
    </section>
  </main>
  <SiteFooter language={language} />
</Base>

<style>
  .nf { text-align: center; padding-block: clamp(3rem, 9vw, 7rem) var(--section); }
  .nf h1 { font-size: clamp(2.25rem, 1.3rem + 3.4vw, 4.5rem); line-height: 1.04; letter-spacing: -0.045em; font-weight: 500; text-wrap: balance; }
  .nf p { margin: 1rem auto 0; max-width: 44ch; color: var(--muted); line-height: 1.5; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); }
  .nf .x-actions { margin-top: 2rem; justify-content: center; }
  .nf__line { width: min(100%, 640px); height: auto; margin: 0 auto clamp(2rem, 5vw, 3.5rem); display: block; }
  .nf__path { stroke-dasharray: 700; stroke-dashoffset: 700; animation: nf-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards; }
  .nf__dash, .nf__end { opacity: 0; animation: nf-fade 0.6s ease 1.7s forwards; }
  @keyframes nf-draw { to { stroke-dashoffset: 0; } }
  @keyframes nf-fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .nf__path { animation: none; stroke-dashoffset: 0; }
    .nf__dash, .nf__end { animation: none; opacity: 1; }
  }
</style>
