---
// Contact (PL "/kontakt", EN "/en/kontakt"): other ways to reach Daniel on the left, the form on
// the right. The form posts to /api/contact (worker/index.ts); scripts/contact.ts runs it.
import '../../styles/next.css';
import '../../styles/contact.css';
import Base from '../../layouts/Base.astro';
import SiteNav from '../site/SiteNav.astro';
import SiteFooter from '../site/SiteFooter.astro';
import { getDict, socials, type Locale } from '../../i18n';

interface Props { language: Locale }
const { language } = Astro.props;
const pl = language === 'pl';
const t = getDict(language);
const alternate = pl ? '/en/kontakt' : '/kontakt';
// Public key; Cloudflare's always-passing test key is used until PUBLIC_TURNSTILE_SITE_KEY is set
const siteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined) || '1x00000000000000000000AA';

const c = pl
  ? {
      seo: { title: 'Kontakt – Nuuvie', description: 'Opowiedz o swoim projekcie. Odpowiadam w ciągu 24 godzin w dni robocze.' },
      title: 'Porozmawiajmy.',
      text: 'Opowiedz mi o swoim projekcie. Odpowiadam w ciągu 24 godzin w dni robocze.',
      other: 'Wolisz inaczej?',
      book: 'Umów 15 minut', bookNote: 'Bezpłatna rozmowa wideo',
      next: 'Co dalej', steps: ['Odpisuję w ciągu 24 godzin.', 'Krótka rozmowa, 15 minut, bez zobowiązań.', 'Propozycja zakresu, terminu i wyceny.'],
      need: 'Czego potrzebujesz?', budget: 'Budżet',
      services: ['Logo i branding', 'Strona lub aplikacja', 'Grafika', 'Strategia i audyt', 'Wsparcie zespołu', 'Mentoring dla designera'],
      budgets: ['do 5 tys. zł', '5–15 tys. zł', '15–40 tys. zł', 'powyżej 40 tys. zł', 'Jeszcze nie wiem'],
      name: 'Imię i nazwisko', email: 'E-mail', company: 'Firma (opcjonalnie)', message: 'Opowiedz o projekcie',
      consentA: 'Zgadzam się na przetwarzanie moich danych w celu odpowiedzi na wiadomość, zgodnie z', consentB: 'polityką prywatności', privacy: '/legal/polityka-prywatnosci',
      // Optional, unticked, not needed to send or get a reply (privacy policy § 9)
      marketing: 'Wyrażam zgodę na otrzymywanie od Nuuvie informacji handlowych drogą elektroniczną (np. e-mailem) oraz na wykorzystanie urządzenia do marketingu bezpośredniego. Mogę ją cofnąć w każdej chwili.',
      optional: 'opcjonalnie',
      send: 'Wyślij wiadomość', sending: 'Wysyłam…', hint: 'albo ⌘ + Enter',
      errors: { name: 'Podaj imię i nazwisko.', email: 'Podaj poprawny adres e-mail.', message: 'Napisz kilka słów o projekcie (min. 10 znaków).', consent: 'Potrzebuję Twojej zgody, żeby odpisać.' },
      fail: 'Nie udało się wysłać. Spróbuj za chwilę albo napisz na', rate: 'Za dużo prób naraz. Spróbuj za minutę albo napisz na',
      done: 'Dzięki! Wiadomość dotarła.', doneText: 'Odpiszę w ciągu 24 godzin w dni robocze. Jeśli to pilne, umów od razu 15 minut.',
      again: 'Wyślij kolejną wiadomość',
    }
  : {
      seo: { title: 'Contact – Nuuvie', description: 'Tell me about your project. I reply within 24 hours on working days.' },
      title: 'Let’s talk.',
      text: 'Tell me about your project. I reply within 24 hours on working days.',
      other: 'Prefer another way?',
      book: 'Book 15 minutes', bookNote: 'Free video call',
      next: 'What happens next', steps: ['I reply within 24 hours.', 'A short call, 15 minutes, no strings attached.', 'A proposal with scope, timing and price.'],
      need: 'What do you need?', budget: 'Budget',
      services: ['Logo & branding', 'Website or app', 'Graphic design', 'Strategy & audit', 'Team support', 'Designer mentoring'],
      budgets: ['under PLN 5k', 'PLN 5–15k', 'PLN 15–40k', 'over PLN 40k', 'Not sure yet'],
      name: 'Full name', email: 'Email', company: 'Company (optional)', message: 'Tell me about the project',
      consentA: 'I agree to my data being processed to reply to this message, in line with the', consentB: 'privacy policy', privacy: '/legal/polityka-prywatnosci',
      marketing: 'I agree to receive commercial information from Nuuvie by electronic means (e.g. email) and to my device being used for direct marketing. I can withdraw this consent at any time.',
      optional: 'optional',
      send: 'Send message', sending: 'Sending…', hint: 'or ⌘ + Enter',
      errors: { name: 'Please enter your name.', email: 'Please enter a valid email address.', message: 'Write a few words about the project (at least 10 characters).', consent: 'I need your consent to reply.' },
      fail: 'Couldn’t send it. Try again in a moment or write to', rate: 'Too many attempts at once. Try again in a minute or write to',
      done: 'Thanks! Your message is in.', doneText: 'I’ll reply within 24 hours on working days. If it’s urgent, book 15 minutes right away.',
      again: 'Send another message',
    };
const arrow = '<svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg>';
---
<Base locale={language} alternate={alternate} title={c.seo.title} description={c.seo.description}>
  <Fragment slot="head">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>
  <SiteNav language={language} alternate={alternate} />

  <main id="top" class="x c">
    <section class="x-wrap c-layout">
      <!-- ───── Left: headline and other ways in ───── -->
      <aside class="c-side">
        <h1 data-x-title>{c.title}</h1>
        <p class="c-lead" data-x-in>{c.text}</p>

        <div class="c-ways" data-x-in>
          <p class="c-label">{c.other}</p>
          <a class="x-card c-way" href={t.contact.bookHref} target="_blank" rel="noopener">
            <span class="c-way__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><rect x="3" y="4.5" width="14" height="12" rx="2.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 8.5h14M7 2.75v3.5M13 2.75v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg></span>
            <span><b>{c.book}</b><em>{c.bookNote}</em></span>
            <span class="x-arrow" aria-hidden="true" set:html={arrow} />
          </a>
          <button class="x-card c-way" type="button" data-x-copy={t.contact.email}>
            <span class="c-way__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><rect x="2.75" y="4.5" width="14.5" height="11" rx="2.5" stroke="currentColor" stroke-width="1.4" /><path d="m3.5 6 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span><b data-x-copy-label>{t.contact.email}</b><em>{pl ? 'Kliknij, żeby skopiować' : 'Click to copy'}</em></span>
          </button>
          <ul class="c-socials">{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
        </div>

        <div class="c-next" data-x-in>
          <p class="c-label">{c.next}</p>
          <ol>{c.steps.map((s) => <li>{s}</li>)}</ol>
        </div>
      </aside>

      <!-- ───── Right: the form ───── -->
      <div class="x-card c-card" data-x-in>
        <form class="c-form" novalidate data-c-form data-lang={language}>
          <fieldset class="c-group">
            <legend class="c-label">{c.need}</legend>
            <div class="c-chips">
              {c.services.map((s) => (
                <label class="c-chip"><input type="checkbox" name="services" value={s} /><span><i aria-hidden="true"></i>{s}</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="c-group">
            <legend class="c-label">{c.budget}</legend>
            <div class="c-chips">
              {c.budgets.map((b) => (
                <label class="c-chip c-chip--radio"><input type="radio" name="budget" value={b} /><span><i aria-hidden="true"></i>{b}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="c-row">
            <div class="c-field" data-field="name">
              <input id="c-name" name="name" type="text" autocomplete="name" placeholder=" " required minlength="2" maxlength="100" />
              <label for="c-name">{c.name}</label>
              <p class="c-error">{c.errors.name}</p>
            </div>
            <div class="c-field" data-field="email">
              <input id="c-email" name="email" type="email" autocomplete="email" placeholder=" " required maxlength="200" />
              <label for="c-email">{c.email}</label>
              <p class="c-error">{c.errors.email}</p>
            </div>
          </div>
          <div class="c-field" data-field="company">
            <input id="c-company" name="company" type="text" autocomplete="organization" placeholder=" " maxlength="120" />
            <label for="c-company">{c.company}</label>
          </div>
          <div class="c-field c-field--area" data-field="message">
            <textarea id="c-message" name="message" placeholder=" " required minlength="10" maxlength="4000" rows="5"></textarea>
            <label for="c-message">{c.message}</label>
            <span class="c-count" aria-hidden="true"><b data-c-count>0</b> / 4000</span>
            <p class="c-error">{c.errors.message}</p>
          </div>

          <!-- Honeypot: invisible to people, irresistible to bots -->
          <div class="c-hp" aria-hidden="true">
            <label for="c-website">Website</label>
            <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="c-field c-field--check" data-field="consent">
            <label class="c-check"><input name="consent" type="checkbox" required /><i aria-hidden="true"></i><span>{c.consentA} <a href={c.privacy} target="_blank">{c.consentB}</a>.</span></label>
            <p class="c-error">{c.errors.consent}</p>
          </div>
          <div class="c-field c-field--check">
            <label class="c-check"><input name="marketing" type="checkbox" /><i aria-hidden="true"></i><span>{c.marketing} <em class="c-optional">({c.optional})</em></span></label>
          </div>

          <div class="cf-turnstile c-turnstile" data-sitekey={siteKey} data-appearance="interaction-only" data-theme="light" data-size="flexible" data-language={language}></div>

          <div class="c-submit">
            <button class="x-btn c-send" type="submit" data-c-send>
              <span class="x-btn__label"><span>{c.send}</span><span aria-hidden="true">{c.send}</span></span>
              <span class="x-btn__icon" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg></span>
            </button>
            <span class="c-hint">{c.hint}</span>
          </div>
          <p class="c-status" role="status" aria-live="polite" data-c-status
            data-sending={c.sending} data-fail={c.fail} data-rate={c.rate} data-email={t.contact.email}></p>
        </form>

        <!-- Success -->
        <div class="c-done" data-c-done hidden tabindex="-1">
          <svg class="c-done__tick" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24" pathLength="1" /><path d="M15 27l7 7 15-16" pathLength="1" /></svg>
          <h2>{c.done}</h2>
          <p>{c.doneText}</p>
          <div class="x-actions">
            <a class="x-btn" href={t.contact.bookHref} target="_blank" rel="noopener"><span class="x-btn__label"><span>{c.book}</span><span aria-hidden="true">{c.book}</span></span><span class="x-btn__icon" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
            <button class="x-btn x-btn--ghost" type="button" data-c-again><span class="x-btn__label"><span>{c.again}</span><span aria-hidden="true">{c.again}</span></span></button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter language={language} />
  <script>
    import '../../scripts/next';
    import '../../scripts/contact';
  </script>
</Base>
