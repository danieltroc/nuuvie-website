---
// Designer Zone (PL "/strefa-designera", EN "/en/strefa-designera"). Text from Sanity
// (designerZonePage-pl / -en); the small UI scenes are drawn here and animated by scripts/strefa.ts.
import '../../styles/next.css';
import '../../styles/strefa.css';
import Base from '../../layouts/Base.astro';
import SiteNav from '../site/SiteNav.astro';
import SiteFooter from '../site/SiteFooter.astro';
import FormFigure from '../strefa/FormFigure.astro';
import QuestionWalk from '../strefa/QuestionWalk.astro';
import { getPage, paragraphs } from '../../lib/pages';
import { getProjects } from '../../lib/sanity';
import { designerZoneContent } from '../../content/pages/designer-zone';
import { getDict, type Locale } from '../../i18n';

interface Props { language: Locale }
const { language } = Astro.props;
const pl = language === 'pl';
const c = await getPage('designerZonePage', language, designerZoneContent[language]);
const buy = c.links?.buyHref ?? designerZoneContent.pl.links.buyHref;
const intro = c.links?.introHref ?? designerZoneContent.pl.links.introHref;
const email = c.links?.email ?? 'hej@nuuvie.com';
const projects = await getProjects(language);
const thumbs = [...(projects.map((p) => p.image).filter(Boolean) as string[]), ...getDict('pl').blog.posts.slice(3, 6).map((p) => p.img)].slice(0, 6);
const brands = ['maersk', 'jabra', 'polpharma', 'tedee'];

// Labels inside the decorative UI scenes
const ui = pl
  ? {
      review: 'Portfolio review', you: 'Ty', comments: 'Komentarze',
      notes: [{ at: 0, text: 'Ten case daj na początek.' }, { at: 4, text: 'Pokaż proces, nie tylko efekt.' }, { at: 2, text: 'Mocniejsza hierarchia nagłówków.' }],
      portfolio: 'Twoje portfolio', cases: '3 projekty', tags: ['Na początek', 'Zostaw', 'Popraw'],
      planTitle: 'Plan rozwoju',
      plan: ['Umiejętności do rozwinięcia', 'Kolejność nauki', 'Projekty do portfolio', 'Narzędzia, które mają znaczenie'],
      feedback: 'Feedback', areasNote: 'obszarów',
      areas: ['UX/UI', 'Webdesign', 'Branding', 'Layouty', 'Typografia', 'Hierarchia', 'Prezentacja'],
      asks: ['Figma czy Webflow?', 'Jak zdobywać pierwszych klientów?'], answer: 'Pokażę Ci na Twoim przykładzie.',
      fig: { session: ['PORTFOLIO', 'FEEDBACK', 'PLAN'], week: 'TYDZ.', goal: 'TWÓJ CEL', skills: ['WEBDESIGN', 'WEBFLOW', 'UX/UI'] },
      photo: 'Daniel Troć przy pracy w studiu',
    }
  : {
      review: 'Portfolio review', you: 'You', comments: 'Comments',
      notes: [{ at: 0, text: 'Put this case first.' }, { at: 4, text: 'Show the process, not just the result.' }, { at: 2, text: 'Stronger heading hierarchy.' }],
      portfolio: 'Your portfolio', cases: '3 projects', tags: ['Lead with it', 'Keep', 'Improve'],
      planTitle: 'Growth plan',
      plan: ['Skills to develop', 'What to learn first', 'Projects for the portfolio', 'Tools that matter'],
      feedback: 'Feedback', areasNote: 'areas',
      areas: ['UX/UI', 'Web design', 'Branding', 'Layouts', 'Typography', 'Hierarchy', 'Presentation'],
      asks: ['Figma or Webflow?', 'How do I find my first clients?'], answer: 'I’ll show you on your own work.',
      fig: { session: ['PORTFOLIO', 'FEEDBACK', 'PLAN'], week: 'WEEK', goal: 'YOUR GOAL', skills: ['WEB DESIGN', 'WEBFLOW', 'UX/UI'] },
      photo: 'Daniel Troć at work in the studio',
    };
const getKeys = ['portfolio', 'plan', 'areas', 'chat'];
const formKinds = ['session', 'solo', 'program', 'group'] as const;
const tick = '<svg viewBox="0 0 12 12" fill="none"><path d="m3 6.2 2 2L9 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>';
// The same page in the other language (language switch + hreflang)
const alternate = pl ? '/en/strefa-designera' : '/strefa-designera';
---
<Base locale={language} alternate={alternate} title={c.seo?.title} description={c.seo?.description}>
  <SiteNav language={language} alternate={alternate} />

  <main id="top" class="x z">
    <!-- ───── Hero ───── -->
    <section class="x-hero">
      <div class="x-wrap x-hero__text">
        <h1 data-x-in>{c.hero.title.replace(/(\d)-(\p{L})/gu, '$1\u2011$2').replace(/(^|\s)([aiouwzAIOUWZ]) /g, '$1$2\u00a0') /* no break at "15-letnim"; one-letter words move to the next line */}</h1>
        <p data-x-in>{c.hero.text}</p>
        <div class="x-actions" data-x-in>
          <a class="x-btn" href={buy}><span class="x-btn__label"><span>{c.hero.buyLabel}</span><span aria-hidden="true">{c.hero.buyLabel}</span></span><span class="x-btn__icon" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
          <a class="x-btn x-btn--ghost" href={intro}><span class="x-btn__label"><span>{c.hero.introLabel}</span><span aria-hidden="true">{c.hero.introLabel}</span></span></a>
        </div>
        <ul class="z-facts" data-x-in>{(c.hero.facts ?? []).map((f) => <li>{f}</li>)}</ul>
      </div>

      <div class="x-wrap x-stage" data-x-stage>
        <div class="x-win" data-x-win aria-hidden="true">
          <div class="x-win__bar">
            <span class="x-dots"><i></i><i></i><i></i></span>
            <span class="x-win__title">{ui.review}</span>
            <span class="x-win__share"><b class="x-ava">D</b><b class="x-ava z-ava--you">{ui.you}</b></span>
          </div>
          <div class="z-review" data-z-review>
            <div class="z-board">
              {thumbs.map((src, i) => {
                const n = ui.notes.findIndex((note) => note.at === i);
                return <span class="z-thumb"><img src={src} alt="" loading="eager" />{n > -1 && <i class="z-pin" data-z-pin={n}>{n + 1}</i>}</span>;
              })}
            </div>
            <aside class="z-comments">
              <p>{ui.comments}</p>
              {ui.notes.map((note, i) => <div class="z-comment" data-z-comment={i}><i>{i + 1}</i><span><b>Daniel</b>{note.text}</span></div>)}
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── The problem ───── -->
    <section class="x-wrap x-sec">
      <header class="x-head"><h2 data-split="lines">{c.problem.title}</h2></header>
      <QuestionWalk questions={c.problem.questions ?? []} />
    </section>

    <!-- ───── What you get ───── -->
    <section class="x-wrap x-sec" id="co-otrzymasz">
      <header class="x-head">
        <h2 data-split="lines">{c.gets.title}</h2>
        <p data-fade>{c.gets.text}</p>
      </header>
      <div class="x-bento z-bento">
        {(c.gets.items ?? []).slice(0, 4).map((g, i) => (
          <article class="x-card x-feat" data-fade>
            <div class="x-feat__gfx" data-scene={getKeys[i]} aria-hidden="true">
              {getKeys[i] === 'portfolio' && (
                <div class="x-panel z-port">
                  <p class="z-head"><b>{ui.portfolio}</b><em>{ui.cases}</em></p>
                  <div class="z-port__row">
                    {thumbs.slice(0, 3).map((src, n) => (
                      <span class="z-port__card" data-card><img src={src} alt="" loading="lazy" /><em class={`z-tag z-tag--${n}`} data-tag>{ui.tags[n]}</em></span>
                    ))}
                  </div>
                </div>
              )}
              {getKeys[i] === 'plan' && (
                <div class="x-panel z-plan">
                  <p class="z-head"><b>{ui.planTitle}</b><em><span data-done>{ui.plan.length}</span>/{ui.plan.length}</em></p>
                  <span class="z-plan__bar"><i data-bar></i></span>
                  <ol>{ui.plan.map((step) => <li data-step><i data-check set:html={tick} />{step}</li>)}</ol>
                </div>
              )}
              {getKeys[i] === 'areas' && (
                <div class="x-panel z-areas">
                  <p class="z-head"><b>{ui.feedback}</b><em><span data-n>{ui.areas.length}</span> {ui.areasNote}</em></p>
                  <div class="z-areas__chips">{ui.areas.map((a) => <span data-chip><i set:html={tick} />{a}</span>)}</div>
                </div>
              )}
              {getKeys[i] === 'chat' && (
                <div class="x-panel z-chat">
                  {ui.asks.map((a) => <div class="x-b" data-b>{a}</div>)}
                  <div class="x-b x-b--me x-b--typing" data-typing><i></i><i></i><i></i></div>
                  <div class="x-b x-b--me" data-b><b class="x-ava">D</b><span>{ui.answer}</span></div>
                </div>
              )}
            </div>
            <div class="x-feat__text"><h3>{g.title}</h3><p>{g.body}</p></div>
          </article>
        ))}
      </div>
    </section>

    <!-- ───── Free intro + who it is not for ───── -->
    <section class="x-wrap x-sec">
      <div class="z-pair">
        <article class="x-card z-box" data-fade>
          <h3>{c.intro.title}</h3>
          <p>{c.intro.text}</p>
          <a class="x-btn" href={intro}><span class="x-btn__label"><span>{c.intro.ctaLabel}</span><span aria-hidden="true">{c.intro.ctaLabel}</span></span><span class="x-btn__icon" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
        </article>
        <article class="x-card z-box z-box--dark" data-fade>
          <h3>{c.notFor.title}</h3>
          <p>{c.notFor.text}</p>
        </article>
      </div>
    </section>

    <!-- ───── Opinions ───── -->
    <section class="x-wrap x-sec">
      <header class="x-head"><h2 data-split="lines">{c.opinions.title}</h2></header>
      <div class="z-dms">
        {(c.opinions.items ?? []).map((o, i) => (
          <figure class="x-card z-dm" data-fade>
            <div class="z-dm__screen" data-scene="dm">
              <div class="z-dm__bar">
                <svg class="z-dm__back" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class={`z-dm__ava z-dm__ava--${i % 3}`} aria-hidden="true"></span>
                <figcaption class="z-dm__who"><b>{o.name}</b><em>Instagram</em></figcaption>
                <svg class="z-dm__icons" viewBox="0 0 40 16" fill="none" aria-hidden="true"><path d="M3.2 2.5h2.3l1.1 2.8-1.4.9a6.5 6.5 0 0 0 3.1 3.1l.9-1.4 2.8 1.1v2.3a1.2 1.2 0 0 1-1.3 1.2A10 10 0 0 1 2 3.8a1.2 1.2 0 0 1 1.2-1.3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /><rect x="22" y="3.5" width="10" height="9" rx="2" stroke="currentColor" stroke-width="1.2" /><path d="m32 7 4-2.2v6.4L32 9" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
              </div>
              <div class="z-dm__row">
                <span class={`z-dm__ava z-dm__ava--sm z-dm__ava--${i % 3}`} aria-hidden="true"></span>
                <div class="z-dm__typing" data-typing aria-hidden="true"><i></i><i></i><i></i></div>
                <blockquote class="z-dm__msg" data-msg>{o.text}<span class="z-dm__heart" data-heart aria-hidden="true">❤️</span></blockquote>
              </div>
            </div>
          </figure>
        ))}
      </div>
    </section>

    <!-- ───── Ways to work together ───── -->
    <section class="x-wrap x-sec" id="formy">
      <header class="x-head x-head--split">
        <h2 data-split="lines">{c.forms.title}</h2>
        <div data-fade><p>{c.forms.text}</p></div>
      </header>
      <div class="x-figs z-forms">
        {(c.forms.items ?? []).slice(0, 4).map((f, i) => (
          <div class="x-fig" data-fade>
            <FormFigure kind={formKinds[i]} labels={ui.fig} />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ───── About ───── -->
    <section class="x-wrap x-sec">
      <div class="x-card z-about" data-fade>
        <div>
          <h2>{c.about.title}</h2>
          <figure class="z-photo" data-x-reveal><img src="/img/strefa/daniel-desk.jpg" alt={ui.photo} width="904" height="1200" loading="lazy" /></figure>
        </div>
        <div class="z-about__text">{paragraphs(c.about.text).map((p) => <p>{p}</p>)}
          <div class="z-brands">{brands.map((b) => <img src={`/img/logos/${b}.svg`} alt={b} width="150" height="100" loading="lazy" />)}</div>
        </div>
      </div>
    </section>

    <!-- ───── Pricing ───── -->
    <section class="x-wrap x-sec" id="cennik">
      <header class="x-head">
        <h2 data-split="lines">{c.pricing.title}</h2>
        <p data-fade>{c.pricing.text}</p>
      </header>
      <div class="z-pair z-pair--even">
        {(c.pricing.plans ?? []).map((plan, i) => (
          <article class:list={['x-card', 'z-price', i === 0 && 'z-box--dark']} data-fade>
            <p class="z-price__for">{plan.audience}</p>
            <h3>{plan.title}</h3>
            <p>{plan.text}</p>
            <p class="z-price__val"><b>{plan.price}</b>{plan.oldPrice && <s>{plan.oldPrice}</s>}</p>
            <a class="x-btn" href={plan.ctaHref}><span class="x-btn__label"><span>{plan.ctaLabel}</span><span aria-hidden="true">{plan.ctaLabel}</span></span><span class="x-btn__icon" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
          </article>
        ))}
      </div>
      <p class="z-alt" data-fade>
        {c.pricing.note}{' '}
        <a href={`mailto:${email}?subject=Mentoring%20%2F%20Konsultacja`}>{email}</a> · <a href="https://www.instagram.com/nuuvie.studio" target="_blank" rel="noopener">Instagram</a>
      </p>
    </section>

    <!-- ───── FAQ ───── -->
    <section class="x-wrap x-sec" id="faq">
      <header class="x-head"><h2 data-split="lines">{c.faq.title}</h2></header>
      <div class="z-faq">
        {(c.faq.items ?? []).map((f) => (
          <details class="x-card" data-fade>
            <summary>{f.question}<i aria-hidden="true"></i></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ───── Final ───── -->
    <section class="x-wrap x-final">
      <div class="x-final__in">
        <h2 data-split="lines">{c.final.title}</h2>
        <p data-fade>{c.final.text}</p>
        <div class="x-actions" data-fade>
          <a class="x-btn" href={buy}><span class="x-btn__label"><span>{c.pricing.plans?.[0]?.ctaLabel ?? c.hero.buyLabel}</span><span aria-hidden="true">{c.pricing.plans?.[0]?.ctaLabel ?? c.hero.buyLabel}</span></span><span class="x-btn__icon" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
          <a class="x-btn x-btn--ghost" href={intro}><span class="x-btn__label"><span>{c.hero.introLabel}</span><span aria-hidden="true">{c.hero.introLabel}</span></span></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter language={language} />
  <script>
    import '../../scripts/next';
    import '../../scripts/strefa';
  </script>
</Base>
