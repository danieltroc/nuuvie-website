---
// Home page (PL "/" and EN "/en"). Text comes from Sanity (homePage-pl / homePage-en);
// the UI graphics are drawn in HTML/SVG here and animated by scripts/next.ts.
import '../../styles/next.css';
import Base from '../../layouts/Base.astro';
import SiteNav from '../site/SiteNav.astro';
import SiteFooter from '../site/SiteFooter.astro';
import BlogList from '../blog/BlogList.astro';
import { getPosts, getProjects, projectPath, blogPath } from '../../lib/sanity';
import { getPage, pic } from '../../lib/pages';
import { homeContent } from '../../content/pages/home';
import { getDict, clientLogos, type Locale } from '../../i18n';

interface Props { language: Locale }
const { language } = Astro.props;
const pl = language === 'pl';
const t = getDict(language);
const c = await getPage('homePage', language, homeContent[language]);
const posts = await getPosts(language);
const projects = await getProjects(language);
const thumbs = getDict('pl').blog.posts.map((p) => p.img);
const workThumbs = projects.map((p) => p.image).filter(Boolean) as string[];

// Labels inside the decorative UI graphics (not content, so they live with the graphics)
const ui = pl
  ? {
      window: 'Identyfikacja wizualna', share: 'Udostępnij', layers: 'Warstwy', layerNames: ['Logo', 'Typografia', 'Kolory', 'Strona główna'],
      fill: 'Wypełnienie', radius: 'Promień', font: 'Krój', align: 'Wyrównanie', audit: 'Audyt UX',
      auditRows: [['Czytelność', 92], ['Hierarchia', 74], ['Spójność', 81], ['Dostępność', 68]],
      issues: [['NUV-24', 'Onboarding: nowy flow', 'progress'], ['NUV-23', 'Design system: przyciski', 'todo'], ['NUV-21', 'Ekran płatności', 'todo'], ['NUV-19', 'Ikony v2', 'done']],
      you: 'Ty', steps: ['Rozmowa', 'Projekt', 'Wdrożenie'], note: 'Ten case daj na początek portfolio.',
    }
  : {
      window: 'Visual identity', share: 'Share', layers: 'Layers', layerNames: ['Logo', 'Typography', 'Colours', 'Home page'],
      fill: 'Fill', radius: 'Radius', font: 'Typeface', align: 'Alignment', audit: 'UX audit',
      auditRows: [['Readability', 92], ['Hierarchy', 74], ['Consistency', 81], ['Accessibility', 68]],
      issues: [['NUV-24', 'Onboarding: new flow', 'progress'], ['NUV-23', 'Design system: buttons', 'todo'], ['NUV-21', 'Payment screen', 'todo'], ['NUV-19', 'Icons v2', 'done']],
      you: 'You', steps: ['Call', 'Design', 'Launch'], note: 'Put this case first in your portfolio.',
    };

const markPath = 'M60.419 90.627C60.419 107.311 46.894 120.836 30.21 120.836C13.526 120.836 0.0002 107.311 0 90.627V30.21C0 13.526 13.526 0 30.21 0H60.419V90.627ZM90.633 0C107.317 0 120.842 13.526 120.842 30.21C120.842 46.868 107.359 60.376 90.711 60.418H120.842V90.627C120.842 107.311 107.317 120.836 90.633 120.836C73.949 120.836 60.424 107.311 60.424 90.627V60.418H90.555C73.907 60.376 60.424 46.868 60.424 30.21C60.424 13.526 73.949 0 90.633 0Z';
// Isometric line figures (pure geometry); figure n goes with c.figures[n]
const box = (cx: number, cy: number, w: number, h: number, d: number) =>
  `M${cx - w} ${cy}L${cx} ${cy - h}L${cx + w} ${cy}V${cy + d}L${cx} ${cy + h + d}L${cx - w} ${cy + d}Z M${cx - w} ${cy}L${cx} ${cy + h}L${cx + w} ${cy} M${cx} ${cy + h}V${cy + h + d}`;
const fin = (x: number, y: number, hgt: number) => `M${x} ${y}L${x + 90} ${y + 45}V${y + 45 - hgt}L${x} ${y - hgt}Z`;
const figPaths = [
  [...[0, 1, 2, 3, 4].map((i) => box(160, 190 - i * 18, 110, 55, 10)), box(160, 86, 110, 55, 10)],
  [box(160, 70, 52, 26, 70), box(102, 105, 52, 26, 80), box(218, 105, 52, 26, 50), box(160, 150, 52, 26, 60)],
  [0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => fin(160 - i * 11, 160 + i * 5.5, 140 - i * 14)),
];
const serviceKeys = ['brand', 'ux', 'graphic', 'audit', 'team'];
---
<Base locale={language} title={c.seo?.title} description={c.seo?.description}>
  <SiteNav language={language} alternate={pl ? '/en' : '/'} />

  <main id="top" class="x">
    <!-- ───── Hero ───── -->
    <section class="x-hero">
      <div class="x-wrap x-hero__text">
        <h1 data-x-in>{c.hero.title}</h1>
        <p data-x-in>{c.hero.text}</p>
        <div class="x-actions" data-x-in>
          {c.hero.primary?.label && <a class="x-btn" href={c.hero.primary.href}>{c.hero.primary.label}</a>}
          {c.hero.secondary?.label && <a class="x-btn x-btn--ghost" href={c.hero.secondary.href}>{c.hero.secondary.label}</a>}
        </div>
      </div>

      <div class="x-wrap x-stage" data-x-stage>
        <div class="x-win" data-x-win aria-hidden="true">
          <div class="x-win__bar">
            <span class="x-dots"><i></i><i></i><i></i></span>
            <span class="x-win__title">{ui.window}</span>
            <span class="x-win__share"><b class="x-ava">D</b><em>{ui.share}</em></span>
          </div>
          <div class="x-win__body">
            <aside class="x-layers">
              <p>{ui.layers}</p>
              {ui.layerNames.map((l, i) => <span class:list={[i === 0 && 'is-on']} data-x-layer={i}><i></i>{l}</span>)}
            </aside>
            <div class="x-canvas" data-x-canvas>
              <div class="x-art x-art--logo" data-x-art="0"><small>{ui.layerNames[0]}</small><svg viewBox="0 0 121 121"><path d={markPath} fill="url(#x-grad)" /><defs><linearGradient id="x-grad" x1="0" y1="60" x2="121" y2="60" gradientUnits="userSpaceOnUse"><stop stop-color="#864AF9"/><stop offset=".69" stop-color="#F0386B"/><stop offset="1" stop-color="#882E47"/></linearGradient></defs></svg></div>
              <div class="x-art x-art--type" data-x-art="1"><small>{ui.layerNames[1]}</small><b>Aa</b><span>BDO Grotesk</span></div>
              <div class="x-art x-art--color" data-x-art="2"><small>{ui.layerNames[2]}</small><i></i><i></i><i></i><i></i></div>
              <div class="x-art x-art--site" data-x-art="3"><small>{ui.layerNames[3]}</small><span class="x-sk x-sk--nav"></span><span class="x-sk x-sk--h"></span><span class="x-sk x-sk--h2"></span><span class="x-sk x-sk--btn"></span><span class="x-sk x-sk--img"></span></div>
              <div class="x-sel" data-x-sel><i></i><i></i><i></i><i></i><em data-x-size>320 × 320</em></div>
              <div class="x-cursor" data-x-cursor><svg viewBox="0 0 16 16"><path d="M2 1.5 13.5 8 8.2 9.2 5.6 14.2Z" /></svg><em>Daniel</em></div>
            </div>
            <aside class="x-props">
              <p>{ui.fill}</p>
              <span class="x-prop"><i class="x-sw"></i>#864AF9</span>
              <p>{ui.radius}</p>
              <span class="x-prop">24</span>
              <p>{ui.font}</p>
              <span class="x-prop">BDO Grotesk</span>
              <p>{ui.align}</p>
              <span class="x-align"><i></i><i></i><i></i></span>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── Logos ───── -->
    <section class="x-wrap x-logos-sec" aria-label={t.clients.label}>
      <div class="x-logos" data-fade>
        {clientLogos.map((l) => <img src={`/img/logos/${l}.svg`} alt={l} width="150" height="100" loading="lazy" />)}
      </div>
    </section>

    <!-- ───── Statement + three figures ───── -->
    <section class="x-wrap x-sec" id="about">
      <p class="x-statement" data-fade>{c.statement.lead} <span>{c.statement.rest}</span></p>
      <div class="x-figs">
        {(c.figures ?? []).slice(0, 3).map((f, i) => (
          <div class="x-fig" data-fade>
            <small>FIG 0.{i + 1}</small>
            <svg viewBox="0 0 320 260" aria-hidden="true" data-x-fig>{figPaths[i].map((d, n) => <path d={d} class:list={[n === figPaths[i].length - 1 && 'is-accent']} />)}</svg>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ───── Work ───── -->
    <section class="x-wrap x-sec" id="work">
      <header class="x-head x-head--split">
        <h2 data-split="lines">{c.work.title}</h2>
        <div data-fade><p>{c.work.text}</p></div>
      </header>
      <div class="x-cols">
        {projects.slice(0, 3).map((w, i) => (
          <a class="x-col" href={projectPath(language, w.slug)} data-fade>
            <div class="x-project__img">{w.image && <img src={w.image} alt={w.imageAlt ?? ''} width="2400" height="1350" loading={i === 0 ? 'eager' : 'lazy'} />}</div>
            <h3>{w.title}. <span>{w.excerpt}</span></h3>
            <span class="x-more">{c.work.linkLabel} →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ───── Services: feature bento with UI graphics ───── -->
    <section class="x-wrap x-sec" id="services">
      <header class="x-head x-head--split">
        <h2 data-split="lines">{c.services.title}</h2>
        <div data-fade><p>{c.services.text}</p><a class="x-more" href="#contact">{c.services.linkLabel} →</a></div>
      </header>
      <div class="x-bento">
        {(c.services.items ?? []).slice(0, 5).map((s, i) => {
          const key = serviceKeys[i];
          return (
            <article class:list={['x-card', 'x-feat', `x-feat--${key}`]} data-fade data-x-feat={key}>
              <div class="x-feat__gfx" aria-hidden="true">
                {key === 'brand' && (
                  <svg class="x-g-brand" viewBox="0 0 400 240">
                    <g class="x-g-guides"><line x1="0" y1="120" x2="400" y2="120" /><line x1="200" y1="0" x2="200" y2="240" /><rect x="139.5" y="59.5" width="121" height="121" /></g>
                    <g transform="translate(139.5 59.5)">
                      <g class="x-g-circles"><circle cx="30.2" cy="90.6" r="30.2" /><circle cx="90.6" cy="30.2" r="30.2" /><circle cx="90.6" cy="90.6" r="30.2" /><circle cx="30.2" cy="30.2" r="30.2" /></g>
                      <path class="x-g-fill" d={markPath} />
                      <path class="x-g-stroke" d={markPath} data-x-draw />
                    </g>
                    <text x="268" y="56">r = 30</text><text x="268" y="196">121 × 121</text>
                  </svg>
                )}
                {key === 'ux' && (
                  <div class="x-g-ux">
                    <div class="x-g-ux__win">
                      <span class="x-sk x-sk--nav"></span><span class="x-sk x-sk--h"></span><span class="x-sk x-sk--h2"></span>
                      <span class="x-sk x-sk--btn" data-x-tap></span>
                      <div class="x-g-ux__cards"><span></span><span></span><span></span></div>
                    </div>
                    <div class="x-cursor x-cursor--ux" data-x-ux-cursor><svg viewBox="0 0 16 16"><path d="M2 1.5 13.5 8 8.2 9.2 5.6 14.2Z" /></svg></div>
                  </div>
                )}
                {key === 'graphic' && (
                  <div class="x-g-posts">{[thumbs[1], thumbs[2], thumbs[0]].map((src) => <div class="x-g-post" data-x-post><img src={src} alt="" loading="lazy" /><span></span><span></span></div>)}</div>
                )}
                {key === 'audit' && (
                  <div class="x-g-audit">
                    <p><b>{ui.audit}</b><span>79 / 100</span></p>
                    {ui.auditRows.map(([label, v]) => <div class="x-g-row"><span>{label}</span><i><b style={`--v:${v}`} data-x-bar></b></i><em>{v}</em></div>)}
                  </div>
                )}
                {key === 'team' && (
                  <div class="x-g-issues">
                    {ui.issues.map(([id, title, state], n) => (
                      <div class="x-g-issue" data-x-issue={n}><i class:list={['x-st', `x-st--${state}`]} data-x-status></i><em>{id}</em><span>{title}</span><b class="x-ava">{n % 2 ? ui.you : 'D'}</b></div>
                    ))}
                  </div>
                )}
              </div>
              <div class="x-feat__text"><h3>{s.title}</h3><p>{s.body}</p></div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ───── Quotes ───── -->
    <section class="x-wrap x-sec">
      <header class="x-head"><h2 data-split="lines">{c.testimonials.title}</h2></header>
      <div class="x-quotes">
        {(c.testimonials.items ?? []).map((q) => (
          <figure class="x-card" data-fade>
            <blockquote>„{q.quote}”</blockquote>
            <figcaption>{pic(q.photo, 160) && <img src={pic(q.photo, 160)} alt="" width="80" height="80" loading="lazy" />}<span><b>{q.name}</b>{q.company}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ───── Two paths ───── -->
    <section class="x-wrap x-sec" id="paths">
      <header class="x-head x-head--split">
        <h2 data-split="lines">{c.paths.title}</h2>
        <div data-fade><p>{c.paths.text}</p></div>
      </header>
      <div class="x-paths">
        <article class="x-card x-path" data-fade>
          <div class="x-path__gfx" aria-hidden="true"><div class="x-g-steps">{ui.steps.map((s, i) => <span data-x-step={i}><i>{i + 1}</i>{s}</span>)}</div></div>
          <h3>{c.paths.business.title}</h3>
          <p>{c.paths.business.text}</p>
          {c.paths.business.cta?.label && <a class="x-btn" href={c.paths.business.cta.href}>{c.paths.business.cta.label}</a>}
        </article>
        <article class="x-card x-path" data-fade>
          <div class="x-path__gfx" aria-hidden="true">
            <div class="x-g-review">
              <div class="x-g-thumbs">{[...workThumbs, ...thumbs.slice(3, 6)].slice(0, 6).map((src, i) => <span class:list={[i === 2 && 'is-pick']}><img src={src} alt="" loading="lazy" /></span>)}</div>
              <div class="x-g-note" data-x-note><b class="x-ava">D</b><p>{ui.note}</p></div>
            </div>
          </div>
          <h3>{c.paths.designer.title}</h3>
          <p>{c.paths.designer.text}</p>
          {c.paths.designer.cta?.label && <a class="x-btn x-btn--ghost" href={c.paths.designer.cta.href}>{c.paths.designer.cta.label}</a>}
        </article>
      </div>
    </section>

    <!-- ───── Blog ───── -->
    <section class="x-wrap x-sec" id="blog">
      <header class="x-head x-head--row">
        <h2 data-split="lines">{c.blog.title}</h2>
        <a class="x-link" href={blogPath(language)} data-fade>{c.blog.linkLabel} →</a>
      </header>
      <BlogList posts={posts.slice(0, 6)} language={language} />
    </section>

    <!-- ───── Final call to action ───── -->
    <section class="x-wrap x-final" id="contact">
      <div class="x-final__in">
        <h2 data-split="lines">{c.contact.title}</h2>
        <p data-fade>{c.contact.text}</p>
        <div class="x-actions" data-fade>
          <a class="x-btn" href={t.contact.bookHref}>{c.contact.ctaLabel}</a>
          <button class="x-btn x-btn--ghost" type="button" data-x-copy={t.contact.email}><span data-x-copy-label>{t.contact.email}</span></button>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter language={language} />
  <script>
    import '../../scripts/next';
  </script>
</Base>
