---
// The four ways to work together, each drawn as a home-page style line figure (grey lines, mono
// labels, one purple accent). Every figure fills the same 300 × 150 frame edge to edge, so it spans
// the full column and lines up with the text below. Animated once on scroll by initFigures() in
// scripts/next.ts (kind "line").
//  session — one 90-minute meeting: portfolio, feedback, plan
//  solo    — regular sessions, growth week by week
//  program — a route through skills to your goal
//  group   — people around one shared session
interface Props {
  kind: 'session' | 'solo' | 'program' | 'group';
  labels: { session: string[]; week: string; goal: string; skills: string[] };
}
const { kind, labels } = Astro.props;
const W = 300;
const AXIS = 116.5;
const LABEL = 138;

// session: 0'–90' along the axis, three blocks of 30 minutes
const minX = (m: number) => Math.min(W - 0.5, Math.max(0.5, (m / 90) * W));

// solo: twelve weekly sessions climbing
const growth = [6, 10, 13, 20, 24, 31, 38, 44, 53, 60, 70, 84];
const pts = growth.map((g, i) => ({ x: 8 + i * ((W - 16) / 11), y: 104 - g }));
const curve = `M${pts.map((pt) => `${pt.x} ${pt.y}`).join(' L')}`;

// program: an orthogonal route with three milestones, ending at the goal
const goal = { x: W - 23, y: 52 };
const stops = [{ x: 96, y: 128 }, { x: 96, y: 88 }, { x: 196, y: 88 }];
const route = `M4 128 H96 V88 H196 V52 H${goal.x - 22}`;

// group: eight people on an ellipse around one shared centre
const centre = { x: W / 2, y: 74 };
const ring = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2;
  return { x: centre.x + Math.cos(a) * (W / 2 - 9), y: centre.y + Math.sin(a) * 56 };
});
---
{kind === 'session' && (
  <svg class="x-figure" viewBox={`0 0 ${W} 150`} aria-hidden="true" data-fig="line">
    {labels.session.map((label, i) => (
      <g>
        <rect class:list={['x-figure__bar', i === 2 && 'is-accent']} x={i * 102 + 0.5} y="52" width="97" height="46" rx="4" data-fig-bar />
        <text class:list={['x-figure__label', i === 2 && 'is-accent']} x={i * 102 + 49} y="78.5" text-anchor="middle" data-fig-label>{label}</text>
      </g>
    ))}
    <line class="x-figure__axis" x1="0" y1={AXIS} x2={W} y2={AXIS} />
    {Array.from({ length: 10 }, (_, i) => i * 10).map((m) => <line class="x-figure__tick" x1={minX(m)} y1={AXIS} x2={minX(m)} y2={m % 45 === 0 ? AXIS + 7 : AXIS + 4} />)}
    <text class="x-figure__label" x="0" y={LABEL} data-fig-label>0′</text>
    <text class="x-figure__label" x={W / 2} y={LABEL} text-anchor="middle" data-fig-label>45′</text>
    <text class="x-figure__label is-accent" x={W} y={LABEL} text-anchor="end" data-fig-label>90′</text>
  </svg>
)}

{kind === 'solo' && (
  <svg class="x-figure" viewBox={`0 0 ${W} 150`} aria-hidden="true" data-fig="line">
    <line class="x-figure__axis" x1="0" y1={AXIS} x2={W} y2={AXIS} />
    {pts.map((pt, i) => <line class="x-figure__tick" x1={pt.x} y1={AXIS} x2={pt.x} y2={i === 0 || i === pts.length - 1 ? AXIS + 7 : AXIS + 4} />)}
    <path class="x-figure__line" d={curve} pathLength="1" data-fig-line />
    <circle class="x-figure__ring" cx={pts[pts.length - 1].x} cy={pts[pts.length - 1].y} r="8" data-fig-dot />
    {pts.map((pt, i) => <circle class:list={[i === pts.length - 1 ? 'x-figure__dot' : 'x-figure__node']} cx={pt.x} cy={pt.y} r={i === pts.length - 1 ? 4 : 2.5} data-fig-dot />)}
    <text class="x-figure__label" x="0" y={LABEL} data-fig-label>{labels.week} 1</text>
    <text class="x-figure__label is-accent" x={W} y={LABEL} text-anchor="end" data-fig-label>{labels.week} 12</text>
  </svg>
)}

{kind === 'program' && (
  <svg class="x-figure" viewBox={`0 0 ${W} 150`} aria-hidden="true" data-fig="line">
    <path class="x-figure__line" d={route} pathLength="1" data-fig-line />
    {[22, 14].map((r) => <circle class="x-figure__ring" cx={goal.x} cy={goal.y} r={r} data-fig-dot />)}
    <circle class="x-figure__dot" cx={goal.x} cy={goal.y} r="5" data-fig-dot />
    <circle class="x-figure__node" cx="4" cy="128" r="3" data-fig-dot />
    {stops.map((s) => <circle class="x-figure__node" cx={s.x} cy={s.y} r="3" data-fig-dot />)}
    {labels.skills.map((skill, i) => (
      <text class="x-figure__label" x={stops[i].x + (i === 1 ? -8 : 8)} y={stops[i].y - 8} text-anchor={i === 1 ? 'end' : 'start'} data-fig-label>{skill}</text>
    ))}
    <text class="x-figure__label is-accent" x={W} y={goal.y + 40} text-anchor="end" data-fig-label>{labels.goal}</text>
  </svg>
)}

{kind === 'group' && (
  <svg class="x-figure" viewBox={`0 0 ${W} 150`} aria-hidden="true" data-fig="line">
    <ellipse class="x-figure__line" cx={centre.x} cy={centre.y} rx={W / 2 - 9} ry="56" pathLength="1" data-fig-line />
    {ring.map((pt) => <line class="x-figure__line" x1={centre.x} y1={centre.y} x2={pt.x} y2={pt.y} pathLength="1" data-fig-line />)}
    <circle class="x-figure__ring" cx={centre.x} cy={centre.y} r="14" data-fig-dot />
    <circle class="x-figure__dot" cx={centre.x} cy={centre.y} r="6" data-fig-dot />
    {ring.map((pt) => <circle class="x-figure__person" cx={pt.x} cy={pt.y} r="8" data-fig-dot />)}
  </svg>
)}
