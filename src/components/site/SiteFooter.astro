---
import Mark from '../Mark.astro';
import { getDict, socials, type Locale } from '../../i18n';
import { blogPath } from '../../lib/sanity';
import { homeHref } from '../../lib/pages';
import { PATH as TT_PATH, isLive } from '../../lib/typo-toolkit';
interface Props { language: Locale }
const { language } = Astro.props;
const t = getDict(language);
const pl = language === 'pl';
const en = pl ? '' : '/en';
const year = new Date().getFullYear();
// Polish only; on nuuvie.com the page opens on 30.11, so the link appears with the first build after that
const showToolkit = pl && (import.meta.env.DEV || isLive(Date.now()));
---
<footer class="x-foot">
  <div class="x-wrap x-foot__grid x-foot__grid--5">
    <div>
      <a class="x-brand" href={homeHref(language)} aria-label="Nuuvie Studio"><Mark id="mark-site-foot" /><span>Nuuvie</span></a>
      <p class="x-foot__tag">{pl ? 'Branding, UX/UI i strony dla firm, które chcą wyglądać tak dobrze, jak działają.' : 'Branding, UX/UI and websites for companies that want to look as good as they work.'}</p>
    </div>
    <div><p>Studio</p><ul>
      <li><a href={`${pl ? '' : '/en'}/work`}>{pl ? 'Prace' : 'Work'}</a></li>
      <li><a href={homeHref(language, '#services')}>{pl ? 'Usługi' : 'Services'}</a></li>
      <li><a href={`${en}/o-nuuvie`}>{pl ? 'O Nuuvie' : 'About'}</a></li>
      <li><a href={blogPath(language)}>Blog</a></li>
    </ul></div>
    <div><p>{pl ? 'Dla designerów' : 'For designers'}</p><ul>
      <li><a href={`${en}/strefa-designera`}>{pl ? 'Strefa Designera' : 'Designer Zone'}</a></li>
      {showToolkit && <li><a href={TT_PATH}>Typo Toolkit 2027</a></li> /* from the launch build on (src/lib/typo-toolkit.ts) */}
    </ul></div>
    <div><p>{pl ? 'Kontakt' : 'Contact'}</p><ul>
      <li><a href={`${en}/kontakt`}>{pl ? 'Formularz kontaktowy' : 'Contact form'}</a></li>
      <li><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></li>
      <li><a href={t.contact.bookHref}>{pl ? 'Umów rozmowę' : 'Book a call'}</a></li>
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul></div>
    <div><p>{pl ? 'Informacje' : 'Info'}</p><ul>
      {t.footer.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      {/* opens the cookie banner again (CookieConsent.astro shows it when the pixel is on) */}
      <li data-ck-open hidden><button type="button" class="x-foot__ck">{pl ? 'Ustawienia cookies' : 'Cookie settings'}</button></li>
    </ul></div>
  </div>
  <p class="x-wrap x-foot__copy">© {year} Nuuvie Studio</p>
</footer>

<style>
  .x-foot__ck { padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; text-align: left; }
  .x-foot__ck:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
