---
// "Form" — the logo's geometry (circle, arch, pill, quarter) becomes the visual language.
import '../../styles/rest.css';
import '../../styles/variants.css';
import Base from '../../layouts/Base.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import MiniNav from '../../components/variants/MiniNav.astro';
import Rest from '../../components/variants/Rest.astro';
import { getDict } from '../../i18n';
const t = getDict('pl');
// shape + colour for each of the nine cells of the hero composition
const cells = [
  ['arch', 'ink'], ['circle', 'violet'], ['quarter', 'pink'],
  ['pill', 'lilac'], ['leaf', 'ink'], ['arch', 'violet'],
  ['quarter', 'violet'], ['pill', 'pink'], ['circle', 'ink'],
];
const masks = ['arch', 'capsule', 'leaf'];
---
<Base locale="pl" theme="form">
  <DesignSwitcher theme="form" />
  <MiniNav id="form" />
  <main id="top">
    <section class="f-hero">
      <div class="f-hero__text">
        <p class="r-label" data-v-in>Nuuvie Studio — UX/UI, branding, strony</p>
        <h1 data-v-in>Nadaję markom kształt, któremu się ufa.</h1>
        <p class="f-hero__sub" data-v-in>Projektuję produkty cyfrowe i marki, które budują zaufanie od pierwszego kontaktu. 15 lat doświadczenia.</p>
        <a class="r-btn" href="#contact" data-v-in>Porozmawiajmy o projekcie</a>
      </div>
      <div class="f-grid" data-f-grid aria-hidden="true">
        {cells.map(([shape, color]) => <div class="f-cell"><i class:list={[`f-${shape}`, `f-c-${color}`]} data-f-shape></i></div>)}
      </div>
    </section>

    <section class="f-work" id="work">
      <div class="r-row">
        <h2 class="r-h" data-fade>{t.work.title}</h2>
        <span class="r-label" data-fade>(0{t.work.items.length})</span>
      </div>
      <div class="f-work__grid">
        {t.work.items.map((w, i) => (
          <a class="f-project" href={w.href} data-fade data-cursor="Zobacz">
            <div class:list={['f-project__img', `f-mask-${masks[i]}`]}><img src={w.img} alt="" width="2400" height="1350" loading="lazy" /></div>
            <h3>{w.name}</h3>
            <p>{w.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <Rest id="form" />
  </main>
  <div class="cursor mono" data-cursor-el aria-hidden="true"><span></span></div>
  <script>
    import '../../scripts/variants';
  </script>
</Base>
