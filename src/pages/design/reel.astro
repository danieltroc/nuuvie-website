---
// "Reel" — the page opens as a horizontal strip of pictures you scroll through sideways.
import '../../styles/rest.css';
import '../../styles/variants.css';
import Base from '../../layouts/Base.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import MiniNav from '../../components/variants/MiniNav.astro';
import Rest from '../../components/variants/Rest.astro';
import { getDict } from '../../i18n';
const t = getDict('pl');
const n = t.work.items.length;
---
<Base locale="pl" theme="reel">
  <DesignSwitcher theme="reel" />
  <MiniNav id="reel" />
  <main id="top">
    <section class="l-reel" id="work" data-l-reel>
      <div class="l-track" data-l-track>
        <div class="l-intro">
          <h1 data-v-in>Projektuję marki i produkty cyfrowe, które budują zaufanie od pierwszego kontaktu.</h1>
          <p data-v-in>Nuuvie Studio. 15 lat doświadczenia w UX/UI i brandingu.</p>
          <span class="l-hint" data-v-in>Przewiń, aby zobaczyć prace →</span>
        </div>
        {t.work.items.map((w, i) => (
          <a class="l-frame" href={w.href} data-cursor="Zobacz">
            <div class="l-frame__img"><img src={w.img} alt="" width="2400" height="1350" loading={i === 0 ? 'eager' : 'lazy'} data-l-img /></div>
            <div class="l-frame__cap">
              <span>0{i + 1} / 0{n}</span>
              <strong>{w.name}</strong>
              <span>{w.tags.join(', ')}</span>
            </div>
          </a>
        ))}
        <div class="l-end">
          <p>Twój projekt może być następny.</p>
          <a class="r-btn" href="#contact">Porozmawiajmy</a>
        </div>
      </div>
      <div class="l-bar" aria-hidden="true"><i data-l-bar></i></div>
    </section>

    <Rest id="reel" />
  </main>
  <div class="cursor mono" data-cursor-el aria-hidden="true"><span></span></div>
  <script>
    import '../../scripts/variants';
  </script>
</Base>
