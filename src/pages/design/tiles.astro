---
// "Tiles" — Apple product-page logic: stacked tiles, headline above picture, calm blue links.
import '../../styles/rest.css';
import '../../styles/variants.css';
import Base from '../../layouts/Base.astro';
import DesignSwitcher from '../../components/DesignSwitcher.astro';
import MiniNav from '../../components/variants/MiniNav.astro';
import Rest from '../../components/variants/Rest.astro';
import { getDict } from '../../i18n';
const t = getDict('pl');
---
<Base locale="pl" theme="tiles">
  <DesignSwitcher theme="tiles" />
  <MiniNav id="tiles" />
  <main id="top">
    <section class="t-hero" data-t-hero>
      <div class="t-hero__text">
        <h1 data-v-in>Nuuvie Studio</h1>
        <p data-v-in>Marki i produkty cyfrowe, którym się ufa od pierwszego kontaktu.</p>
        <div class="t-links" data-v-in>
          <a class="r-btn" href="#contact">Porozmawiajmy</a>
          <a class="t-more" href="#work">Zobacz prace</a>
        </div>
      </div>
      <div class="t-fan" aria-hidden="true">
        {t.work.items.map((w) => <div class="t-fan__card" data-t-card><img src={w.img} alt="" width="2400" height="1350" /></div>)}
      </div>
    </section>

    <section class="t-tiles" id="work">
      {t.work.items.map((w) => (
        <a class="t-tile" href={w.href} data-fade>
          <img src={w.img} alt="" width="2400" height="1350" loading="lazy" />
          <div class="t-tile__text">
            <h2>{w.name}</h2>
            <p>{w.desc}</p>
            <span class="t-more">Zobacz projekt</span>
          </div>
        </a>
      ))}
    </section>

    <Rest id="tiles" />
  </main>
  <script>
    import '../../scripts/variants';
  </script>
</Base>
