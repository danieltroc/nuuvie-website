---
// Typo Toolkit 2027 (/sklep/typo-toolkit): 250 font pairs (PDF), a guide, a Figma file and a Claude
// skill. Content: "Plan strony Typo Toolkit 2027, wersja 4" (Google Doc). Pairs come from the Figma
// file "Fonts" (EX25p6ADKUXa1qs8G0qrZy). Built on the "Next" design (styles/next.css).
// Price windows, the launch time, the checkout and sample links: src/lib/typo-toolkit.ts. Before
// the launch the Worker shows this page only on *.workers.dev (worker/index.ts).
import '../../styles/next.css';
import '../../styles/typo-toolkit.css';
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Offer from '../../components/typo-toolkit/Offer.astro';
import { Image, getImage } from 'astro:assets';
import sCover from '../../assets/typo-toolkit/s-cover.png';
import s011 from '../../assets/typo-toolkit/s-011.png';
import s230 from '../../assets/typo-toolkit/s-230.png';
import s162 from '../../assets/typo-toolkit/s-162.png';
import s137 from '../../assets/typo-toolkit/s-137.png';
import s116 from '../../assets/typo-toolkit/s-116.png';
import s225 from '../../assets/typo-toolkit/s-225.png';
import { getDict, socials } from '../../i18n';
import { CHECKOUT, SAMPLE, PHASES, phaseAt } from '../../lib/typo-toolkit';

const t = getDict('pl');
const year = new Date().getFullYear();
// The window at build time; the script switches to the current one in the browser
const phase = phaseAt(Date.now());
const buyHref = CHECKOUT || '#cena';

// Where each font shown on this page comes from. Fontshare = ITF FFL, everything else = SIL OFL.
const fontshare = new Set(['Clash Display', 'Satoshi', 'Gambetta', 'General Sans', 'Cabinet Grotesk', 'Zodiak', 'Boska', 'Telma', 'Switzer']);
const source = (f: string) => (fontshare.has(f) ? { src: 'Fontshare', lic: 'ITF FFL' } : { src: 'Google Fonts', lic: 'SIL OFL' });

// Pairs from the set, with their page number in the PDF and their chapter.
// Page numbers, chapters and heading weights (hw) as on the slides in the Figma file (285 pages).
const chapters = [
  { name: 'Codzienne', count: 20, page: 9 },
  { name: 'Nieoczekiwane', count: 20, page: 30 },
  { name: 'Uniwersalne', count: 20, page: 51 },
  { name: 'Nowoczesne', count: 20, page: 72 },
  { name: 'Klasyczne', count: 20, page: 93 },
  { name: 'Edytorskie', count: 20, page: 114 },
  { name: 'Biznes / SaaS', count: 20, page: 135 },
  { name: 'Lifestyle / Moda / Beauty', count: 20, page: 156 },
  { name: 'Techniczne / Developerskie', count: 20, page: 177 },
  { name: 'Trendy 2027', count: 30, page: 198 },
  { name: 'Mix w nagłówku', count: 20, page: 229 },
  { name: 'Mix w nagłówku: Google Fonts', count: 20, page: 250 },
];
const raw = [
  { n: 11, ch: 1, h: 'Clash Display', hw: 600, b: 'Satoshi' },
  { n: 137, ch: 7, h: 'Sora', hw: 600, b: 'DM Sans' },
  { n: 162, ch: 8, h: 'Marcellus', hw: 400, b: 'Poppins' },
  { n: 12, ch: 1, h: 'Gambetta', hw: 500, b: 'General Sans' },
  { n: 33, ch: 2, h: 'Boska', hw: 500, b: 'Martian Mono' },
  { n: 230, ch: 11, h: 'Satoshi', hw: 900, b: 'Instrument Serif' },
  { n: 65, ch: 3, h: 'Fraunces', hw: 500, b: 'Rethink Sans' },
];
// Real slides exported from the Figma file (node ids in the comments), shown in the album strip
const slides = [
  { img: sCover, cap: 'Typo Toolkit 2027 · okładka', alt: 'Okładka Typo Toolkit 2027: dwanaście krojów pisma i napis 250 par' }, // 195:173
  { img: s011, cap: 's. 11 · Codzienne · Clash Display × Satoshi', alt: 'Slajd z parą Clash Display i Satoshi: nagłówek „Faktura poszła sama o 6:02”' }, // 256:6604
  { img: s230, cap: 's. 230 · Mix w nagłówku · Satoshi × Instrument Serif', alt: 'Slajd z parą Satoshi i Instrument Serif: nagłówek „Robimy etykiety dla 12 browarów”' }, // 256:6646
  { img: s162, cap: 's. 162 · Lifestyle / Moda / Beauty · Marcellus × Poppins', alt: 'Slajd z parą Marcellus i Poppins: nagłówek „Koloryzacja, wtorek 16:30”' }, // 246:5362
  { img: s137, cap: 's. 137 · Biznes / SaaS · Sora × DM Sans', alt: 'Slajd z parą Sora i DM Sans: nagłówek „Przelew za fakturę w 11 sekund”' }, // 246:4694
  { img: s116, cap: 's. 116 · Edytorskie · EB Garamond × Roboto', alt: 'Slajd z parą EB Garamond i Roboto: nagłówek „Ceny mieszkań rosną wolniej”' }, // 255:4535
  { img: s225, cap: 's. 225 · Trendy 2027 · Zalando Sans Expanded × Momo Trust Sans', alt: 'Slajd z parą Zalando Sans Expanded i Momo Trust Sans: nagłówek „Regał składany bez narzędzi”' }, // 255:5513
];
// Share image: the cover slide
const og = await getImage({ src: sCover, width: 1200, format: 'jpg', quality: 82 });
// Hero: the cover first, then real pair slides from different chapters
const heroSlides = [slides[0], slides[1], slides[3], slides[2], slides[4]];
const pairs = raw.map((p) => {
  const hs = source(p.h), bs = source(p.b);
  return {
    ...p,
    chapter: `${String(p.ch).padStart(2, '0')} ${chapters[p.ch - 1].name}`,
    src: [...new Set([hs.src, bs.src])].join(' + '),
    lic: [...new Set([hs.lic, bs.lic])].join(' + '),
  };
});
// Fontshare's CSS API returns only the first font of a multi-font request, so one link per font
const fontsUrls = [
  ...['clash-display@600', 'satoshi@400,700,900', 'gambetta@500', 'general-sans@400', 'cabinet-grotesk@800', 'zodiak@400', 'boska@500', 'telma@700', 'switzer@400']
    .map((f) => `https://api.fontshare.com/v2/css?f[]=${f}&display=swap`),
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Petrona:wght@400&family=Martian+Mono:wght@400&family=Instrument+Serif&family=Fraunces:opsz,wght@9..144,500&family=Rethink+Sans:wght@400&family=Sora:wght@600&family=DM+Sans:wght@400&family=Marcellus&family=Poppins:wght@400&display=swap',
];
// "Aa" tiles: tiles 5 and 6 light up together as one real pair (Clash Display × Satoshi)
const tiles = ['Gambetta', 'Telma', 'Zodiak', 'Boska', 'Fraunces', 'Clash Display', 'Satoshi', 'Instrument Serif', 'Cabinet Grotesk', 'Bricolage Grotesque', 'Switzer', 'General Sans'];

const steps = [
  { t: 'Pobierz', d: '26 krojów spoza Google Fonts ma w pliku link do strony autora. Przy każdym podane są numery stron, na których jest użyty.' },
  { t: 'Zainstaluj', d: 'Pliki .otf: na macOS dwuklik i „Zainstaluj”, na Windows „Zainstaluj dla wszystkich użytkowników”.' },
  { t: 'Zrestartuj Figmę', d: 'Zamknij Figmę i otwórz ją ponownie. Fonty z Google Fonts działają od razu, bez instalacji.' },
];

// Big numbers under the hero (from the catalogue, checked 27.11)
const stats = [
  { n: 250, suf: '', t: 'par fontów', d: 'każda na polskim tekście, w gotowym układzie' },
  { n: 209, suf: '', t: 'krojów pisma', d: 'od codziennych po Trendy 2027' },
  { n: 12, suf: '', t: 'rozdziałów', d: 'pod typ projektu, po 20 par' },
  { n: 82, suf: '%', t: 'użyć z Google Fonts', d: 'działają w Figmie od razu' },
];
const pains = [
  'Przeglądasz fonty w nieskończoność.',
  'Kończysz na bezpiecznym wyborze: kolejny projekt z Interem.',
  'Znajdziesz font, a potem szukasz mu pary: kolejne godziny, kolejne próby.',
];
const benefits = [
  { t: 'Czas', d: 'Otwierasz rozdział pasujący do projektu i wybierasz z 20 par. Szukasz pary pod SaaS? Masz cały rozdział, od strony 135.' },
  { t: 'Poza domyślnym wyborem', d: '209 krojów w 250 parach, od codziennych po Trendy 2027. Masz z czego wybierać, gdy chcesz wyjść poza kolejny projekt z Interem.' },
  { t: 'Pewność wyboru', d: 'Widzisz parę w prawdziwym układzie, zanim wstawisz ją do projektu: nagłówek z akapitem na polskim tekście, w konkretnym zastosowaniu, np. salon fryzjerski, kancelaria, fintech.' },
  { t: 'Argumenty dla klienta', d: 'Przy każdej parze masz krótkie uzasadnienie, dlaczego działa, np. „Clash ma charakter i ostre detale, a Satoshi jest neutralny i bardzo czytelny”. Od tego łatwiej zacząć rozmowę z klientem.' },
];
// Skill: a real answer from the test on 27.11 (pages and notes match the catalogue)
const convo = [
  { tier: 'Bezpieczna', pair: 'Zilla Slab × Inter', page: 173, why: 'Zilla Slab ma cyfry nautyczne, więc kwoty w menu warto sprawdzić przed drukiem.' },
  { tier: 'Z charakterem', pair: 'Young Serif × Instrument Sans', page: 22, why: 'Young Serif ma jedną grubość, więc hierarchię budujesz rozmiarem.' },
  { tier: 'Odważna', pair: 'Rubik Mono One × Fraunces', page: 44, why: 'Rubik Mono One to same wersaliki: „zł” w nagłówku zmieni się w „ZŁ”.' },
];
const skillCan = [
  { t: 'Trzy pary pod klienta', d: 'Bezpieczna, z charakterem i odważna, każda z uzasadnieniem i numerem strony w albumie.' },
  { t: 'Ograniczenia klienta', d: 'Tylko Google Fonts, Canva, druk, cenniki z kwotami. Pisze też, z których par zrezygnował i dlaczego.' },
  { t: 'Szczegóły krojów', d: 'Cyfry w cennikach, brak kursywy, same wersaliki.' },
  { t: 'Zamiennik płatnego kroju', d: 'Np. dla Circulara znajduje darmowe kroje z albumu i uczciwie opisuje różnice.' },
  { t: 'Szkielet typograficzny', d: 'Rozmiary na telefon i desktop, gotowy kod (Next.js, Tailwind) i tokeny do pobrania.' },
  { t: 'Licencje i wdrożenie', d: 'Co wolno z każdym fontem i jak osadzić fonty na stronie bez wysyłania danych do Google.' },
];
const audience = [
  { who: 'projektujesz produkty cyfrowe', where: 'Biznes / SaaS i Techniczne / Developerskie', n: 40 },
  { who: 'projektujesz marki i identyfikacje', where: 'Klasyczne, Edytorskie i Lifestyle / Moda / Beauty', n: 60 },
  { who: 'dopiero uczysz się łączyć fonty', where: 'Codzienne', n: 20 },
  { who: 'masz doświadczenie i szukasz nowych kombinacji', where: 'Nieoczekiwane i Trendy 2027', n: 50 },
];
const needs = [
  'Czytnik PDF.',
  'Do pliku Figma: konto Figma.',
  'Do skilla: Claude. Działa w aplikacji Claude, w przeglądarce i na komputerze.',
  'Fonty spoza Google Fonts (26 krojów) instalujesz raz.',
];
const priceRows = [
  { id: '59', name: 'Premierowe', price: '59 zł', when: '30.11, 8:00 – 1.12, 23:59', what: '250 par, poradnik, plik Figma, skill do Claude' },
  { id: '69', name: 'Startowe', price: '69 zł', when: '2.12 – 7.12, 23:59', what: '250 par, poradnik, plik Figma, skill do Claude' },
  { id: '79', name: 'Regularne', price: '79 zł', when: 'od 8.12', what: '250 par, poradnik, plik Figma. Skill do Claude: +29 zł przy zakupie zestawu (razem 108 zł)' },
];
const faq = [
  { q: 'Dlaczego nie wziąć darmowych par z internetu?', a: 'Możesz. Tutaj 250 par jest już wybranych i pokazanych na polskim tekście w gotowym układzie, z opisem „dlaczego działa” i linkiem do pobrania. Płacisz za godziny, które oszczędzasz na szukaniu i porównywaniu.' },
  { q: 'Dlaczego cena rośnie?', a: 'Najniższa cena jest dla osób, które kupią w tygodniu premiery. Cena rośnie w trzech oknach, tylko w górę, a terminy z tabeli są stałe.' },
  { q: 'Czy mogę użyć tych par w projektach klientów?', a: 'Tak. Wszystkie fonty są darmowe do użytku komercyjnego, licencja jest podana przy każdym foncie. PDF-a, pliku Figma i skilla nie rozsyłasz ani nie sprzedajesz dalej.' },
  { q: 'Czy mogę pokazać pary klientowi lub wysłać mu PDF?', a: 'Pokaż pojedyncze slajdy na ekranie w prezentacji i wybierzcie razem. Całego PDF-a nie przesyłaj.' },
  { q: 'Czy fonty obsługują polskie znaki?', a: 'Każda para jest pokazana na polskim tekście z ą, ę, ł i ż, więc od razu widzisz, jak wyglądają.' },
  { q: 'Czego potrzebuję?', a: 'Czytnika PDF. Do pliku Figma konta Figma. Skill działa w aplikacji Claude, w przeglądarce i na komputerze. Fonty spoza Google Fonts (26 krojów) instalujesz raz.' },
  { q: 'Czym jest skill i czy muszę go mieć?', a: 'To plik ZIP, który wgrywasz do Claude: w menu bocznym Plugins → Add → Upload plugin i wybierasz typo-toolkit-skill.zip. Skill potrzebuje przełącznika „Create and edit files” (Settings → Capabilities), który zwykle jest już włączony. Opisujesz projekt, a skill proponuje trzy pary z albumu z numerami stron i uzasadnieniem, a na wybranej parze buduje szkielet typograficzny z kodem i tokenami. Do PDF-a i Figmy nie jest potrzebny. W cenie zestawu do 7.12, od 8.12 dodasz go przy zakupie za 29 zł (razem 108 zł).' },
  { q: 'Dlaczego skill nie jest sprzedawany osobno?', a: 'Skill korzysta z par i opisów z zestawu, dlatego dostępny jest tylko razem z nim. Od 8.12 dodajesz go w chwili zakupu zestawu, razem 108 zł. Później dokupić go nie można.' },
  { q: 'Czy mogę pracować w Figmie z agentem AI?', a: 'Tak, przez Figma MCP, ale limity odczytu zależą od planu Figma i od tego, gdzie leży plik. Na darmowym planie to tylko kilka lub kilkanaście odczytów miesięcznie.' },
  { q: 'Kiedy i jak dostanę pliki?', a: 'Po zaksięgowaniu płatności dostajesz e-mail z linkiem do pobrania (PDF ok. 66 MB) i dostępem do pliku Figma.' },
  { q: 'Czy mogę zwrócić zakup?', a: 'Treść cyfrowa jest dostarczana od razu. Po wyrażeniu zgody na natychmiastowe dostarczenie nie przysługuje prawo odstąpienia. Jeśli plik nie działa lub jest niezgodny z opisem, napisz, reklamację rozpatrzę w 14 dni.' },
];
const nav = [
  { href: '#srodek', label: 'Co w środku' },
  { href: '#cena', label: 'Cena' },
  { href: '#faq', label: 'FAQ' },
];
const arrow = '<svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg>';
---
<Base locale="pl" image={og.src} title="Typo Toolkit 2027: 250 par fontów i plik Figma | Nuuvie" description="250 par fontów dla projektantów, każda na polskim tekście w gotowym układzie. Do tego poradnik, plik Figma i skill do Claude.">
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="preconnect" href="https://api.fontshare.com" crossorigin />
  {fontsUrls.map((href) => <link slot="head" rel="stylesheet" href={href} />)}

  <header class="x-nav">
    <div class="x-nav__blur" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="x-wrap x-nav__in">
      <a class="x-brand" href="/" aria-label="Nuuvie Studio"><Mark id="mark-tt-nav" /><span>Nuuvie</span></a>
      <nav aria-label="Menu">{nav.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
      <div class="x-nav__right">
        <a class="x-btn x-btn--sm" href={buyHref} data-tt-buy><span class="x-btn__label"><span>Kup Typo Toolkit</span><span aria-hidden="true">Kup Typo Toolkit</span></span><span class="x-btn__icon" aria-hidden="true" set:html={arrow + arrow} /></a>
      </div>
    </div>
  </header>

  <main id="top" class="x f tt" data-tt data-phases={JSON.stringify(PHASES)} data-phase={phase.id}>
    <!-- ───── Hero ───── -->
    <section class="x-hero" data-tt-hero>
      <div class="x-wrap x-hero__text">
        <h1 data-x-title><span class="tt-h1-name">Typo Toolkit 2027:</span> fonty bez <em>zgadywania</em></h1>
        <p data-x-in>250 par fontów dla projektantów, każda na polskim tekście w gotowym układzie. Otwierasz rozdział pod projekt i wybierasz z 20 par. Do tego poradnik, plik Figma i skill do Claude.</p>
        <div data-x-in><Offer phase={phase} buyHref={buyHref} /></div>
      </div>

      <div class="x-wrap x-stage" data-x-stage>
        <div class="x-win tt-deck" data-x-win data-tt-deck data-pairs={JSON.stringify(pairs)}>
          <div class="x-win__bar">
            <span class="x-dots"><i></i><i></i><i></i></span>
            <span class="x-win__title" data-tt-deck-cap aria-live="polite">{heroSlides[0].cap}</span>
          </div>
          <div class="tt-deck__stage">
            {heroSlides.map((s, i) => (
              <Image class:list={[i === 0 && 'is-on']} src={s.img} alt={s.alt} widths={[960, 1440, 1920]} sizes="(min-width: 1200px) 76rem, 94vw" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} data-tt-deck-slide data-cap={s.cap} />
            ))}
          </div>
          <div class="tt-deck__dots" role="group" aria-label="Slajdy z albumu">
            {heroSlides.map((s, i) => <button type="button" aria-label={s.cap} aria-pressed={i === 0 ? 'true' : 'false'} data-tt-deck-dot={i}><i></i></button>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ───── Numbers ───── -->
    <section class="x-wrap tt-stats" aria-label="W liczbach">
      <ul class="tt-nums">{stats.map((s) => <li data-fade><b><span data-tt-count-to={s.n}>{s.n}</span>{s.suf}</b><strong>{s.t}</strong><span>{s.d}</span></li>)}</ul>
    </section>

    <!-- ───── Problem ───── -->
    <section class="x-wrap x-sec">
      <header class="x-head">
        <h2 data-split="lines">Przeglądasz, porównujesz, łączysz… i mija godzina.</h2>
      </header>
      <ol class="tt-pains">{pains.map((p, i) => <li class="x-card" data-fade><i>{i + 1}</i><p>{p}</p></li>)}</ol>
      <div class="tt-story" data-fade>
        <p>Znam to z własnych projektów. Dlatego zacząłem „Pary fontów”. Zapytałem projektantów w ankiecie na Instagramie, z czym mają największy problem. Prawie połowa odpowiedziała: wszystko po trochu. Więc dokończyłem projekt i tak powstał Typo Toolkit 2027.</p>
        <p><b>Typo Toolkit 2027 to dopracowane, kompletne narzędzie do pracy z typografią.</b> Dostajesz gotowe pary, poradnik i plik, z którego od razu pracujesz.</p>
      </div>
    </section>

    <!-- ───── What is inside ───── -->
    <section class="x-wrap x-sec" id="srodek">
      <header class="x-head">
        <h2 data-split="lines">Co jest w środku</h2>
        <p data-fade>Album PDF (285 stron) z 250 parami i poradnikiem, plik Figma z tymi samymi parami i skill do Claude, który zna cały album.</p>
      </header>
      <div class="x-bento f-bento">
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="tiles" aria-hidden="true">
            <div class="f-tiles">{tiles.map((f, i) => <span class:list={[i === 5 && 'is-ink', i === 6 && 'is-accent']} style={`font-family:'${f}'`} data-f-tile data-f-pair={i === 5 || i === 6 ? '' : undefined}>Aa</span>)}</div>
          </div>
          <div class="x-feat__text"><h3>250 par w 12 rozdziałach</h3><p>Od codziennych, przez Biznes i SaaS, po Lifestyle i trendy na 2027. Każda para na osobnym slajdzie, w prawdziwym zastosowaniu, na polskim tekście: nazwy i grubości, krótkie „dlaczego działa”, licencja i link do pobrania.</p></div>
        </article>
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="chapters" aria-hidden="true">
            <ol class="f-toc-mini">
              {['Jak łączyć dwa kroje', 'Na co uważać', 'Hierarchia treści', 'Typografia do projektu', 'Licencje w praktyce'].map((c, i) => (
                <li data-row class:list={[i === 2 && 'is-pick']}><i>{String(i + 1).padStart(2, '0')}</i><span>{c}</span><b></b></li>
              ))}
            </ol>
          </div>
          <div class="x-feat__text"><h3>Poradnik</h3><p>Moje praktyki pracy z typografią: jak łączyć dwa kroje i na co uważać, jak budować hierarchię treści, jak dobrać typografię do projektu. Jest na końcu albumu, obok par, na których pokazuję przykłady.</p></div>
        </article>
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="album" aria-hidden="true">
            <div class="f-album">
              {pairs.slice(0, 3).map((p, i) => (
                <div class:list={['f-page', i === 1 && 'is-pick']} data-f-page>
                  <b style={`font-family:'${p.h}';font-weight:${p.hw}`}>Aa</b>
                  <span style={`font-family:'${p.b}'`}>{p.h}<br />× {p.b}</span>
                  {i === 1 && <em data-pick>Do projektu</em>}
                </div>
              ))}
            </div>
          </div>
          <div class="x-feat__text"><h3>Plik Figma</h3><p>Wszystkie 250 par gotowych do skopiowania do projektu. Fonty z Google Fonts (82% użyć) działają w Figmie od razu, pozostałe 26 krojów instalujesz raz.</p></div>
        </article>
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="licence" aria-hidden="true">
            <ul class="f-checks tt-chat">
              <li><span>„Kawiarnia, ciepło i trochę retro, menu drukowane”</span></li>
              <li><span>Zilla Slab × Inter · s. 173</span><i data-check>✓</i></li>
              <li><span>Young Serif × Instrument Sans · s. 22</span><i data-check>✓</i></li>
              <li><span>Rubik Mono One × Fraunces · s. 44</span><i data-check>✓</i></li>
            </ul>
          </div>
          <div class="x-feat__text"><h3>Skill do Claude</h3><p>Opisujesz klienta jednym zdaniem i dostajesz trzy pary z albumu z numerami stron. Działa w aplikacji Claude, w przeglądarce i na komputerze. <a href="#skill">Co jeszcze potrafi ↓</a></p></div>
        </article>
      </div>
