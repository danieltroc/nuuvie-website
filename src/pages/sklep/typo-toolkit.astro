---
// TYPO Toolkit 2027 (/sklep/typo-toolkit): 250 font pairs (PDF), a guide, a Figma file and a Claude
// skill. Content: "Plan strony TYPO Toolkit 2027, wersja 4" (Google Doc). Pairs come from the Figma
// file "Fonts" (EX25p6ADKUXa1qs8G0qrZy). Built on the "Next" design (styles/next.css).
// Price windows, the launch time, the checkout and sample links: src/lib/typo-toolkit.ts. Before
// the launch the Worker shows this page only on *.workers.dev (worker/index.ts).
import '../../styles/next.css';
import '../../styles/typo-toolkit.css';
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { getDict, socials } from '../../i18n';
import { CHECKOUT, SAMPLE, PHASES, phaseAt } from '../../lib/typo-toolkit';

const t = getDict('pl');
const year = new Date().getFullYear();
// The window at build time; the script switches to the current one in the browser
const phase = phaseAt(Date.now());
const buyHref = CHECKOUT || '#cena';

// Where each font shown on this page comes from. Fontshare = ITF FFL, everything else = SIL OFL.
const fontshare = new Set(['Clash Display', 'Satoshi', 'Gambetta', 'General Sans', 'Cabinet Grotesk', 'Zodiak', 'Boska', 'Telma', 'Switzer']);
const source = (f: string) => (fontshare.has(f) ? { src: 'Fontshare', lic: 'ITF FFL' } : { src: 'Google Fonts', lic: 'SIL OFL' });

// Pairs from the set, with their page number in the PDF and their chapter.
// hw = heading weight on this page (to check against the slides). The first three are the preview
// pages named in the plan (s. 11, 158, 183).
const chapters = [
  { name: 'Codzienne', count: 20, page: 9 },
  { name: 'Nieoczekiwane', count: 20, page: 30 },
  { name: 'Mix w nagłówku', count: 20, page: 51 },
  { name: 'Nagłówek + akapit', count: 20, page: 72 },
  { name: 'Nowoczesne', count: 20, page: 93 },
  { name: 'Klasyczne', count: 20, page: 114 },
  { name: 'Edytorskie', count: 20, page: 135 },
  { name: 'Biznes / SaaS', count: 20, page: 156 },
  { name: 'Lifestyle / Moda / Beauty', count: 20, page: 177 },
  { name: 'Techniczne / Developerskie', count: 20, page: 198 },
  { name: 'Mix w nagłówku: Google Fonts', count: 20, page: 219 },
  { name: 'Trendy 2027', count: 30, page: 240 },
];
const raw = [
  { n: 11, ch: 1, h: 'Clash Display', hw: 600, b: 'Satoshi' },
  { n: 158, ch: 8, h: 'Sora', hw: 600, b: 'DM Sans' },
  { n: 183, ch: 9, h: 'Marcellus', hw: 400, b: 'Poppins' },
  { n: 12, ch: 1, h: 'Gambetta', hw: 500, b: 'General Sans' },
  { n: 33, ch: 2, h: 'Boska', hw: 500, b: 'Martian Mono' },
  { n: 52, ch: 3, h: 'Satoshi', hw: 700, b: 'Instrument Serif' },
  { n: 86, ch: 4, h: 'Fraunces', hw: 500, b: 'Rethink Sans' },
];
const pairs = raw.map((p) => {
  const hs = source(p.h), bs = source(p.b);
  return {
    ...p,
    chapter: `${String(p.ch).padStart(2, '0')} ${chapters[p.ch - 1].name}`,
    src: [...new Set([hs.src, bs.src])].join(' + '),
    lic: [...new Set([hs.lic, bs.lic])].join(' + '),
  };
});
// Fontshare's CSS API returns only the first font of a multi-font request, so one link per font
const fontsUrls = [
  ...['clash-display@600', 'satoshi@400,700', 'gambetta@500', 'general-sans@400', 'cabinet-grotesk@800', 'zodiak@400', 'boska@500', 'telma@700', 'switzer@400']
    .map((f) => `https://api.fontshare.com/v2/css?f[]=${f}&display=swap`),
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Petrona:wght@400&family=Martian+Mono:wght@400&family=Instrument+Serif&family=Fraunces:opsz,wght@9..144,500&family=Rethink+Sans:wght@400&family=Sora:wght@600&family=DM+Sans:wght@400&family=Marcellus&family=Poppins:wght@400&display=swap',
];
// "Aa" tiles: tiles 5 and 6 light up together as one real pair (Clash Display × Satoshi)
const tiles = ['Gambetta', 'Telma', 'Zodiak', 'Boska', 'Fraunces', 'Clash Display', 'Satoshi', 'Instrument Serif', 'Cabinet Grotesk', 'Bricolage Grotesque', 'Switzer', 'General Sans'];

const licences = [
  {
    name: 'SIL OFL',
    from: 'Google Fonts i inne źródła. Licencja zawsze podana przy foncie. Większość krojów w zestawie.',
    can: ['Używasz komercyjnie: strony, aplikacje, druk, logo', 'Przekazujesz pliki fontu klientowi, developerowi lub drukarni', 'Osadzasz font w aplikacji i w PDF-ie', 'Modyfikujesz font, np. przycinasz webfont do potrzebnych znaków'],
    cant: ['Sprzedawać samego pliku fontu jako produktu', 'Wydawać zmodyfikowanej wersji pod zastrzeżoną nazwą oryginału'],
  },
  {
    name: 'ITF FFL',
    from: 'Fontshare, m.in. Satoshi, Clash Display, Zodiak i General Sans.',
    can: ['Używasz komercyjnie, także w logo i znakach towarowych', 'Hostujesz font na własnej stronie i osadzasz w aplikacji', 'Dzielisz się plikiem wewnątrz własnej firmy', 'Wysyłasz drukarni gotowe pliki do druku'],
    cant: ['Przekazywać pliku fontu klientowi, agencji ani freelancerowi. Każdy pobiera go sam z fontshare.com', 'Modyfikować, przycinać ani konwertować pliku fontu', 'Udostępniać fontu w narzędziach i szablonach dla innych użytkowników'],
  },
  {
    name: 'Ubuntu Font Licence',
    from: 'Rodzina Ubuntu.',
    can: ['Używasz komercyjnie: strony, aplikacje, druk', 'Przekazujesz i osadzasz plik fontu', 'Modyfikujesz font'],
    cant: ['Wydawać zmienionej wersji pod oryginalną nazwą Ubuntu'],
  },
];

const steps = [
  { t: 'Pobierz', d: '26 krojów spoza Google Fonts ma w pliku link do strony autora. Przy każdym podane są numery stron, na których jest użyty.' },
  { t: 'Zainstaluj', d: 'Pliki .otf: na macOS dwuklik i „Zainstaluj”, na Windows „Zainstaluj dla wszystkich użytkowników”.' },
  { t: 'Zrestartuj Figmę', d: 'Zamknij Figmę i otwórz ją ponownie. Fonty z Google Fonts działają od razu, bez instalacji.' },
];

const stats = ['250 par', '12 rozdziałów', 'ok. 210 krojów', 'każda para na polskim tekście', 'źródło i licencja przy każdym foncie'];
const pains = [
  'Przeglądasz fonty w nieskończoność.',
  'Kończysz na bezpiecznym wyborze: kolejny projekt z Interem.',
  'Znajdziesz font, a potem szukasz mu pary: kolejne godziny, kolejne próby.',
];
const benefits = [
  { t: 'Czas', d: 'Zamiast przeglądać dziesiątki kart w przeglądarce, otwierasz rozdział pasujący do projektu i wybierasz z 20 par. Szukasz pary pod SaaS? To cały rozdział.' },
  { t: 'Poza domyślnym wyborem', d: 'Ok. 210 różnych krojów w 250 parach, od codziennych po trendy na 2027. Masz z czego wybierać, gdy chcesz wyjść poza kolejny projekt z Interem.' },
  { t: 'Pewność wyboru', d: 'Widzisz parę w prawdziwym układzie, zanim wstawisz ją do projektu: nagłówek z akapitem, na polskim tekście, w konkretnym zastosowaniu, np. salon, kancelaria, fintech.' },
  { t: 'Argumenty dla klienta', d: 'Przy każdej parze masz krótkie uzasadnienie, dlaczego działa, np. „Clash ma charakter i ostre detale, a Satoshi jest neutralny i bardzo czytelny”. Od tego łatwiej zacząć rozmowę z klientem.' },
  { t: 'Licencje bez szukania', d: 'Przy każdym foncie źródło i licencja. Od razu wiesz, co wolno, np. że fonty z Fontshare klient pobiera sam.' },
  { t: 'Polski tekst', d: 'Każda próbka jest po polsku, z ą, ę, ł i ż, więc ogonki widzisz, zanim wybierzesz parę.' },
  { t: 'Gotowe w Figmie', d: 'Fonty z Google Fonts działają w Figmie od razu (ok. 82% użyć w poradniku). Pozostałe 26 krojów instalujesz raz. Kopiujesz parę do projektu zamiast odtwarzać ją od zera.' },
  { t: 'Poradnik', d: 'Najlepsze praktyki w jednym miejscu: parowanie krojów, hierarchia treści, typografia do projektu. Skrót zamiast szukania po blogach.' },
  { t: 'Skill do Claude', d: 'Pierwszy przegląd pod Twój opis projektu: podpowiada parę z uzasadnieniem i buduje system typograficzny na wybranym foncie. W cenie zestawu do 7.12, od 8.12 dodasz go do zestawu za 29 zł. Nie sprzedaję go osobno.' },
];
const audience = [
  { who: 'projektujesz produkty cyfrowe', where: 'Biznes / SaaS i Techniczne / Developerskie', n: 40 },
  { who: 'projektujesz marki i identyfikacje', where: 'Klasyczne, Edytorskie i Lifestyle / Moda / Beauty', n: 60 },
  { who: 'dopiero uczysz się łączyć fonty', where: 'Codzienne', n: 20 },
  { who: 'masz doświadczenie i szukasz nowych kombinacji', where: 'Nieoczekiwane i Trendy 2027', n: 50 },
];
const needs = [
  'Czytnik PDF.',
  'Do pliku Figma: konto Figma.',
  'Do skilla: konto Claude z włączonym wykonywaniem kodu.',
  'Fonty spoza Google Fonts instalujesz raz.',
];
const priceRows = [
  { id: '59', name: 'Premierowe', price: '59 zł', when: '30.11, 8:00 – 1.12, 23:59', what: '250 par, poradnik, plik Figma, skill do Claude' },
  { id: '69', name: 'Startowe', price: '69 zł', when: '2.12 – 7.12, 23:59', what: 'to samo' },
  { id: '79', name: 'Regularne', price: '79 zł', when: 'od 8.12', what: '250 par, poradnik, plik Figma. Skill do Claude: +29 zł przy zakupie zestawu' },
];
const faq = [
  { q: 'Dlaczego nie wziąć darmowych par z internetu?', a: 'Możesz, wiedza o typografii jest w sieci. Płacisz za oszczędzony czas: 250 par jest już wybranych, pokazanych na polskim tekście w gotowym układzie, z opisem „dlaczego działa”, licencją i linkiem.' },
  { q: 'Dlaczego cena rośnie?', a: 'Najniższa cena to nagroda za szybką decyzję w tygodniu premiery. Cena rośnie w trzech oknach, tylko w górę, bez promocji i przekreśleń, a terminy są prawdziwe.' },
  { q: 'Czy mogę użyć tych par w projektach klientów?', a: 'Tak. Pary jako pomysł stosujesz w swoich i klienckich projektach. Fonty podlegają licencjom autorów podanym przy parze (SIL OFL, ITF FFL z Fontshare, Ubuntu Font Licence). Przy fontach z Fontshare nie przekazujesz klientowi pliku fontu, klient pobiera go sam. PDF-a, pliku Figma i skilla nie rozsyłasz ani nie sprzedajesz dalej.' },
  { q: 'Czy mogę pokazać pary klientowi lub wysłać mu PDF?', a: 'Pokaż pojedyncze slajdy na ekranie w prezentacji i wybierzcie razem. Całego PDF-a nie przesyłaj.' },
  { q: 'Czy fonty obsługują polskie znaki?', a: 'Każda para jest pokazana na polskim tekście z ą, ę, ł i ż, więc od razu widzisz, jak wyglądają.' },
  { q: 'Czego potrzebuję?', a: 'Czytnika PDF. Do pliku Figma konta Figma. Do skilla konta Claude z włączonym wykonywaniem kodu. Fonty spoza Google Fonts instalujesz raz.' },
  { q: 'Czym jest skill i czy muszę go mieć?', a: 'To plik, który wgrywasz do Claude (Customize → Skills). Opisujesz projekt, a skill podpowiada parę z poradnika i uzasadnia wybór, a także buduje system typograficzny na wybranym foncie. Wymaga Claude z włączonym wykonywaniem kodu. Nie jest potrzebny do PDF-a i Figmy. W cenie zestawu do 7.12, od 8.12 dodasz go do zestawu za 29 zł przy zakupie.' },
  { q: 'Dlaczego skill nie jest sprzedawany osobno?', a: 'Skill korzysta z par i opisów z zestawu, dlatego dostępny jest tylko razem z nim. Dodajesz go w chwili zakupu zestawu. Później dokupić go nie można.' },
  { q: 'Czy mogę pracować w Figmie z agentem AI?', a: 'Tak, przez Figma MCP, ale limity odczytu zależą od planu Figma i od tego, gdzie leży plik. Na darmowym planie to tylko kilka lub kilkanaście odczytów miesięcznie.' },
  { q: 'Kiedy i jak dostanę pliki?', a: 'Po zaksięgowaniu płatności dostajesz e-mail z linkiem do pobrania (PDF ok. 66 MB) i dostępem do pliku Figma.' },
  { q: 'Czy mogę zwrócić zakup?', a: 'Treść cyfrowa jest dostarczana od razu. Po wyrażeniu zgody na natychmiastowe dostarczenie nie przysługuje prawo odstąpienia. Jeśli plik nie działa lub jest niezgodny z opisem, napisz, reklamację rozpatrzę w 14 dni.' },
];
const nav = [
  { href: '#srodek', label: 'Co w środku' },
  { href: '#cena', label: 'Cena' },
  { href: '#faq', label: 'FAQ' },
];
const arrow = '<svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M3.5 2H10v6.5" stroke="currentColor" stroke-width="1.5" /></svg>';
const priceLabel = (p: typeof phase) => (p.price ? `${p.price} zł` : 'Wkrótce');
---
<Base locale="pl" title="TYPO Toolkit 2027: 250 par fontów i plik Figma | Nuuvie" description="Kompletny zestaw do pracy z typografią: 250 par fontów na polskim tekście, poradnik, plik Figma i skill do Claude. Premiera 30.11.">
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="preconnect" href="https://api.fontshare.com" crossorigin />
  {fontsUrls.map((href) => <link slot="head" rel="stylesheet" href={href} />)}

  <header class="x-nav">
    <div class="x-nav__blur" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="x-wrap x-nav__in">
      <a class="x-brand" href="/" aria-label="Nuuvie Studio"><Mark id="mark-tt-nav" /><span>Nuuvie</span></a>
      <nav aria-label="Menu">{nav.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
      <div class="x-nav__right">
        <a class="x-btn x-btn--sm" href={buyHref} data-tt-buy><span class="x-btn__label"><span>Kup TYPO Toolkit</span><span aria-hidden="true">Kup TYPO Toolkit</span></span><span class="x-btn__icon" aria-hidden="true" set:html={arrow + arrow} /></a>
      </div>
    </div>
  </header>

  <main id="top" class="x f tt" data-tt data-phases={JSON.stringify(PHASES)} data-phase={phase.id}>
    <!-- ───── Hero ───── -->
    <section class="x-hero" data-tt-hero>
      <div class="x-wrap x-hero__text">
        <p class="tt-kicker" data-x-in>TYPO Toolkit 2027</p>
        <h1 data-x-title>Fonty bez <em>zgadywania</em></h1>
        <p data-x-in>Kompletny zestaw do pracy z typografią: 250 par fontów w prawdziwych układach, poradnik, plik Figma i skill do Claude.</p>
        <div class="tt-offer" data-x-in>
          <div class="tt-price">
            <b data-tt-price>{priceLabel(phase)}</b>
            <span data-tt-note>{phase.note}</span>
            <span class="tt-count" data-tt-count hidden></span>
          </div>
          <p class="tt-badge" data-tt-badge hidden={!phase.badge}>{phase.badge}</p>
          <div class="x-actions">
            <a class="x-btn" href={buyHref} data-tt-buy data-tt-buy-main><span class="x-btn__label"><span data-tt-buy-label>Kup TYPO Toolkit 2027 · {priceLabel(phase)}</span><span aria-hidden="true" data-tt-buy-label>Kup TYPO Toolkit 2027 · {priceLabel(phase)}</span></span><span class="x-btn__icon" aria-hidden="true" set:html={arrow + arrow} /></a>
            <a class="tt-link" href="#probka">Zobacz darmową próbkę ↓</a>
          </div>
          <p class="tt-trust">Ceny brutto · dostęp w e-mailu po płatności · PDF (ok. 66 MB) + plik Figma</p>
        </div>
      </div>

      <div class="x-wrap x-stage" data-x-stage>
        <div class="x-win f-spec" data-x-win data-f-spec data-pairs={JSON.stringify(pairs)} aria-hidden="true">
          <div class="x-win__bar">
            <span class="x-dots"><i></i><i></i><i></i></span>
            <span class="x-win__title">Para <b data-f-idx>{pairs[0].n}</b> / 250 · <span data-f-chap>{pairs[0].chapter}</span></span>
            <span class="x-win__share"><em>Polskie znaki</em></span>
          </div>
          <div class="f-spec__body">
            <div class="f-spec__sample" data-f-sample>
              <span class="f-spec__aa" data-f-h>Ąę</span>
              <p class="f-spec__h" data-f-h>Dobra para robi połowę roboty.</p>
              <p class="f-spec__b" data-f-b>Nagłówek przyciąga, tekst prowadzi. Kiedy dwa kroje do siebie pasują, cała strona od razu wygląda na przemyślaną. Zażółć gęślą jaźń.</p>
            </div>
            <aside class="f-spec__props">
              <p>Nagłówki</p><span class="x-prop" data-f-hname>{pairs[0].h} {pairs[0].hw}</span>
              <p>Tekst</p><span class="x-prop" data-f-bname>{pairs[0].b}</span>
              <p>Źródło</p><span class="x-prop" data-f-src>{pairs[0].src}</span>
              <p>Licencja</p><span class="x-prop" data-f-lic>{pairs[0].lic}</span>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- ───── Numbers ───── -->
    <section class="x-wrap tt-stats" aria-label="W liczbach">
      <ul data-fade>{stats.map((s) => <li>{s}</li>)}</ul>
    </section>

    <!-- ───── Problem ───── -->
    <section class="x-wrap x-sec">
      <header class="x-head">
        <h2 data-split="lines">Przeglądasz, porównujesz, łączysz… i mija godzina.</h2>
      </header>
      <ol class="tt-pains">{pains.map((p, i) => <li class="x-card" data-fade><i>{i + 1}</i><p>{p}</p></li>)}</ol>
      <div class="tt-story" data-fade>
        <p>Znam to z własnych projektów. Dlatego zacząłem „Pary fontów”. Zapytałem projektantów w ankiecie na Instagramie, z czym mają największy problem. Prawie połowa odpowiedziała: wszystko po trochu. Więc dokończyłem projekt i tak powstał TYPO Toolkit 2027.</p>
        <p><b>Wiedza o typografii jest dostępna w sieci. Tu dostajesz skrót:</b> gotowe pary, licencje opisane przy każdym foncie i plik, z którego od razu pracujesz.</p>
      </div>
    </section>

    <!-- ───── What is inside ───── -->
    <section class="x-wrap x-sec" id="srodek">
      <header class="x-head">
        <h2 data-split="lines">Co jest w środku</h2>
        <p data-fade>Cztery części, które razem skracają drogę od pustego pliku do dobranej typografii.</p>
      </header>
      <div class="x-bento f-bento">
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="tiles" aria-hidden="true">
            <div class="f-tiles">{tiles.map((f, i) => <span class:list={[i === 5 && 'is-ink', i === 6 && 'is-accent']} style={`font-family:'${f}'`} data-f-tile data-f-pair={i === 5 || i === 6 ? '' : undefined}>Aa</span>)}</div>
          </div>
          <div class="x-feat__text"><h3>250 par w 12 rozdziałach</h3><p>Od codziennych, przez Biznes i SaaS, po Lifestyle i trendy na 2027. Każda para na osobnym slajdzie, w prawdziwym zastosowaniu, na polskim tekście: nazwy i grubości, krótkie „dlaczego działa”, licencja i link do pobrania.</p></div>
        </article>
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="chapters" aria-hidden="true">
            <ol class="f-toc-mini">
              {['Jak łączyć dwa kroje', 'Na co uważać', 'Hierarchia treści', 'Typografia do projektu', 'Licencje w praktyce'].map((c, i) => (
                <li data-row class:list={[i === 2 && 'is-pick']}><i>{String(i + 1).padStart(2, '0')}</i><span>{c}</span><b></b></li>
              ))}
            </ol>
          </div>
          <div class="x-feat__text"><h3>Poradnik</h3><p>Moje praktyki pracy z typografią: jak łączyć dwa kroje i na co uważać, jak budować hierarchię treści, jak dobrać typografię do projektu. Skrót, nie kurs od zera.</p></div>
        </article>
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="album" aria-hidden="true">
            <div class="f-album">
              {pairs.slice(0, 3).map((p, i) => (
                <div class:list={['f-page', i === 1 && 'is-pick']} data-f-page>
                  <b style={`font-family:'${p.h}';font-weight:${p.hw}`}>Aa</b>
                  <span style={`font-family:'${p.b}'`}>{p.h}<br />× {p.b}</span>
                  {i === 1 && <em data-pick>Do projektu</em>}
                </div>
              ))}
            </div>
          </div>
          <div class="x-feat__text"><h3>Plik Figma</h3><p>Pary gotowe do skopiowania do projektu. Pracujesz w nim ręcznie albo z agentem AI przez Figma MCP (limity odczytu zależą od planu Figma). Fonty z Google Fonts działają od razu, pozostałe instalujesz raz.</p></div>
        </article>
        <article class="x-card x-feat" data-fade>
          <div class="x-feat__gfx" data-scene="licence" aria-hidden="true">
            <ul class="f-checks tt-chat">
              <li><span>„Strona kancelarii, spokojna, poważna”</span></li>
              <li><span>Marcellus × Poppins</span><i data-check>✓</i></li>
