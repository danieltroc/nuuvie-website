          </details>
        ))}
      </div>
    </section>

    <!-- ───── Licences ───── -->
    <section class="x-wrap x-sec" id="licencje">
      <header class="x-head">
        <h2 data-split="lines">Licencje</h2>
        <p data-fade>Wszystkie fonty w zestawie są darmowe u autorów i pozwalają na użytek komercyjny. Licencja i link do pobrania są podane przy każdym foncie.</p>
      </header>
    </section>

    <!-- ───── Final CTA ───── -->
    <section class="x-wrap x-final" id="kup" data-tt-final>
      <div class="x-final__in f-buy">
        <h2 data-split="lines">250 par, poradnik, plik Figma i skill do Claude</h2>
        <div data-fade><Offer phase={phase} buyHref={buyHref} dark /></div>
      </div>
    </section>
  </main>

  <!-- Sticky bar: after the hero leaves the screen, hidden at the final CTA -->
  <div class="tt-bar" data-tt-bar aria-hidden="true">
    <div class="x-wrap tt-bar__in">
      <span data-tt-bar-text>{phase.bar}</span>
      <a class="x-btn x-btn--sm" href={buyHref} data-tt-buy tabindex="-1"><span class="x-btn__label"><span>Kup</span><span aria-hidden="true">Kup</span></span></a>
    </div>
  </div>

  <footer class="x-foot">
    <div class="x-wrap x-foot__grid">
      <div>
        <a class="x-brand" href="/" aria-label="Nuuvie Studio"><Mark id="mark-tt-foot" /><span>Nuuvie</span></a>
        <p>Studio projektowe Daniela Trocia.</p>
      </div>
      <div><p>Typo Toolkit 2027</p><ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
      <div><p>Social media</p><ul>{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul></div>
      <div><p>Informacje</p><ul>
        {t.footer.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/legal/warunki-typo-toolkit-2027">Warunki korzystania z Typo Toolkit 2027</a></li>
        <li><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></li>
      </ul></div>
    </div>
    <p class="x-wrap x-foot__copy">© {year} Nuuvie Studio</p>
  </footer>

  <script>
    import '../../scripts/next';
    import '../../scripts/typo-toolkit';
  </script>
</Base>
