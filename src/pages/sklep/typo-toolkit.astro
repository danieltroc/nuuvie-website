        <h2 data-split="lines">Co z tego masz</h2>
      </header>
      <div class="tt-benefits">
        {benefits.map((b) => <article class="x-card" data-fade><h3>{b.t}</h3><p>{b.d}</p></article>)}
      </div>
      <div class="tt-after" data-fade>
        <a class="x-btn" href={buyHref} data-tt-buy><span class="x-btn__label"><span>Kup teraz</span><span aria-hidden="true">Kup teraz</span></span><span class="x-btn__icon" aria-hidden="true" set:html={arrow + arrow} /></a>
      </div>
    </section>

    <!-- ───── Preview ───── -->
    <section class="x-wrap x-sec" id="pary">
      <header class="x-head">
        <h2 data-split="lines">Zobacz, jak wygląda środek.</h2>
        <p data-fade>Prawdziwe slajdy z zestawu. Każda para ma swój slajd: przykład w konkretnym zastosowaniu, nazwy i grubości krojów, krótkie „dlaczego działa” i link do pobrania.</p>
      </header>
      <div class="tt-album" data-fade>
        <ul class="tt-album__track" tabindex="0" aria-label="Slajdy z Typo Toolkit 2027 (przewiń w bok)">
          {slides.map((s, i) => (
            <li>
              <figure>
                <Image src={s.img} alt={s.alt} widths={[640, 960, 1440]} sizes="(min-width: 900px) 62vw, 86vw" loading={i < 2 ? 'eager' : 'lazy'} />
