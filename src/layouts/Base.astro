---
// Fonts (SIL Open Font License), self-hosted: Bricolage Grotesque with its optical-size axis, Inter
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { type Locale, getDict } from '../i18n';
interface Props {
  locale: Locale;
  /** Design tokens set; the site currently uses only "next" (styles/next.css). */
  theme?: string;
  title?: string;
  description?: string;
  /** Keep a page out of search engines (drafts, test pages). */
  noindex?: boolean;
  /** Path of the same page in the other language, if it exists (adds hreflang links). */
  alternate?: string;
}
const { locale, theme = 'next', title, description, noindex = false, alternate } = Astro.props;
const t = getDict(locale);
const site = Astro.site ?? new URL('https://www.nuuvie.com');
// One canonical address per page, without a trailing slash (same as the old Webflow site)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, site);
// Tells search engines which address to show for Polish and English searchers.
// Polish is x-default: the version for everyone else.
const alternates = alternate
  ? { [locale]: canonical.href, [locale === 'pl' ? 'en' : 'pl']: new URL(alternate.replace(/\/$/, '') || '/', site).href }
  : null;
---
<!doctype html>
<html lang={locale} class="no-js" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates && !noindex && (
      <>
        <link rel="alternate" hreflang="pl" href={alternates.pl} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="x-default" href={alternates.pl} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? t.meta.title} />
    <meta property="og:description" content={description ?? t.meta.description} />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : 'en_GB'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Umami (cookie-free), the same site as on the old Webflow site so the stats carry on.
        data-domains: counts only on www.nuuvie.com, never on workers.dev or localhost. */}
    {import.meta.env.PROD && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="fc31093f-1780-4c7b-8461-99b4316f6974" data-domains="www.nuuvie.com"></script>}
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      // Failsafe: if motion.ts has not started within 3 s (blocked or failed), show all content
      setTimeout(() => {
        if (!document.documentElement.classList.contains('motion-ready')) document.documentElement.classList.add('motion-off');
      }, 3000);
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
