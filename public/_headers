# Cloudflare response headers (https://developers.cloudflare.com/workers/static-assets/headers/)

# Built JS/CSS have a content hash in the file name, so they can be cached forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video change rarely; a week in the browser, revalidated after that
/img/*
  Cache-Control: public, max-age=604800

/video/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
